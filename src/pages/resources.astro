---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import { resources } from '../data/resources';
---

<Layout title="Resources" description="Free SAT Math resources from Eric — PDFs and practice material to accompany each video.">

  <!-- Hero -->
  <section class="bg-ink-mid text-chalk py-10 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="font-sans text-4xl lg:text-6xl font-black tracking-tight mb-4">Resources</h1>
      <p class="text-chalk/70 font-semibold text-lg"><Highlight>Free</Highlight> PDFs to go along with each video.</p>
    </div>
  </section>

  <!-- Accordion list -->
  <section class="py-12 lg:py-16 bg-chalk">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 flex flex-col gap-4">
      <!-- Score Improvement Calculator -->
      <a
        href="/calculator"
        class="resource-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm flex items-center gap-4 px-6 py-4 hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
      >
        <div class="w-20 h-14 flex-shrink-0 bg-electric border-2 border-ink rounded-lg flex items-center justify-center">
          <svg class="w-8 h-8 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2"/>
            <rect x="7" y="5" width="10" height="4" rx="1"/>
            <line x1="7" y1="13" x2="9" y2="13"/>
            <line x1="11" y1="13" x2="13" y2="13"/>
            <line x1="15" y1="13" x2="17" y2="13"/>
            <line x1="7" y1="17" x2="9" y2="17"/>
            <line x1="11" y1="17" x2="13" y2="17"/>
            <line x1="15" y1="17" x2="17" y2="17"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-sans font-extrabold text-lg text-ink leading-snug">Score Improvement Calculator</p>
          <p class="text-ink/60 font-semibold text-sm mt-0.5">See how many hours you need to reach your goal score.</p>
        </div>
        <svg class="flex-shrink-0 w-5 h-5 text-ink" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.293 4.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L10.586 9 7.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>

      {resources.map((r) => (
        <div class="resource-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">

          <!-- Header row -->
          <button class="resource-trigger w-full flex items-center gap-4 px-6 py-4 text-left">
            <img
              src={`https://img.youtube.com/vi/${r.youtubeId}/hqdefault.jpg`}
              alt={r.title}
              class="w-20 h-14 object-cover rounded-lg border-2 border-ink flex-shrink-0"
            />
            <div class="flex-1 min-w-0">
              <p class="font-sans font-extrabold text-lg text-ink leading-snug">{r.title}</p>
              <p class="text-ink/60 font-semibold text-sm mt-0.5 truncate">{r.description}</p>
            </div>
            <svg
              class="resource-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path fill-rule="evenodd" d="M7.293 4.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L10.586 9 7.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Expandable body -->
          <div class="resource-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 p-6 border-t-2 border-ink">

              <!-- YouTube embed (src set lazily by JS) -->
              <div class="aspect-video border-2 border-ink rounded-xl overflow-hidden">
                <iframe
                  data-src={`https://www.youtube.com/embed/${r.youtubeId}`}
                  title={r.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  class="w-full h-full"
                ></iframe>
              </div>

              <!-- Resource card -->
              <div class="bg-chalk border-2 border-ink rounded-xl p-5 flex flex-col">
                <img
                  src={r.previewImage}
                  alt={r.resourceName}
                  class="w-full rounded-lg border-2 border-ink mb-4 object-cover"
                />
                <p class="font-sans font-extrabold text-lg text-ink mb-1">{r.resourceName}</p>
                <p class="text-ink/60 font-semibold text-sm leading-relaxed mb-5 flex-1">{r.resourceDescription}</p>
                <button
                  class="download-trigger bg-coral text-chalk font-bold py-3 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-center"
                  data-resource-file={r.resourceFile}
                >
                  Download PDF
                </button>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Shared download modal -->
  <div id="modal" class="hidden fixed inset-0 bg-ink/60 flex items-center justify-center z-50 px-4">
    <div class="bg-white border-2 border-ink rounded-2xl shadow-offset-md p-8 max-w-md w-full relative">
      <button id="close-modal" class="absolute top-4 right-5 text-ink/40 hover:text-ink text-2xl font-black leading-none">&times;</button>

      <!-- Email capture form -->
      <div id="modal-form">
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5">Enter your email to download</h2>
        <div class="flex flex-col gap-4">
          <input
            id="email-input"
            type="email"
            placeholder="your@email.com"
            class="border-2 border-ink rounded-xl px-4 py-3 text-base text-ink placeholder-ink/40 focus:outline-none focus:ring-2 focus:ring-coral focus:border-coral w-full"
          />
          <div class="flex items-start gap-3">
            <input id="consent-checkbox" type="checkbox" class="mt-1 w-4 h-4 accent-coral flex-shrink-0" />
            <label for="consent-checkbox" class="text-sm text-ink/70 font-semibold leading-snug">
              I agree to receive promotional and instructional emails from LearnSATMath.
            </label>
          </div>
          <p id="modal-error" class="hidden text-red-600 text-sm font-semibold">Please enter a valid email and check the box above.</p>
          <button
            id="submit-download"
            class="bg-coral text-chalk font-bold py-3 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
          >
            Download PDF
          </button>
        </div>
      </div>

      <!-- Success state: cross-sell -->
      <div id="modal-success" class="hidden text-center">
        <h2 class="font-sans font-extrabold text-xl text-ink mb-2">Your download is starting! 🎉</h2>
        <p class="text-ink/60 font-semibold text-sm leading-relaxed mb-5">
          Want every SAT math concept explained from the ground up? My book covers it all — for the price of one tutoring hour.
        </p>
        <a
          href="/book"
          class="block bg-coral text-chalk font-bold py-3 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          See the Book — $49 →
        </a>
        <a href="/masterclass" class="inline-block mt-3 text-sm font-bold text-ink/50 underline hover:text-ink transition-colors">
          or explore the Masterclass
        </a>
      </div>
    </div>
  </div>

</Layout>

<script>
  // ── Accordion ──────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.resource-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.resource-item') as HTMLElement;
      const body = item.querySelector<HTMLElement>('.resource-body')!;
      const arrow = item.querySelector<HTMLElement>('.resource-arrow')!;
      const isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

      // Close all items
      document.querySelectorAll<HTMLElement>('.resource-body').forEach(b => { b.style.maxHeight = '0px'; });
      document.querySelectorAll<HTMLElement>('.resource-arrow').forEach(a => { a.style.transform = ''; });
      document.querySelectorAll<HTMLIFrameElement>('.resource-body iframe').forEach(f => { f.src = ''; });

      if (!isOpen) {
        const iframe = body.querySelector<HTMLIFrameElement>('iframe');
        if (iframe?.dataset.src) iframe.src = iframe.dataset.src;
        body.style.maxHeight = body.scrollHeight + 'px';
        arrow.style.transform = 'rotate(90deg)';
      }
    });
  });

  // ── Download modal ─────────────────────────────────────────
  const modal = document.getElementById('modal')!;
  const closeBtn = document.getElementById('close-modal')!;
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const checkbox = document.getElementById('consent-checkbox') as HTMLInputElement;
  const errorMsg = document.getElementById('modal-error')!;
  const submitBtn = document.getElementById('submit-download')!;
  const modalForm = document.getElementById('modal-form')!;
  const modalSuccess = document.getElementById('modal-success')!;
  let activeFile = '';

  document.querySelectorAll<HTMLButtonElement>('.download-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      activeFile = btn.dataset.resourceFile ?? '';
      emailInput.value = '';
      checkbox.checked = false;
      errorMsg.classList.add('hidden');
      modalForm.classList.remove('hidden');
      modalSuccess.classList.add('hidden');
      modal.classList.remove('hidden');
    });
  });

  closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

  const isValidEmail = (e: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);

  submitBtn.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    if (!isValidEmail(email) || !checkbox.checked) {
      errorMsg.classList.remove('hidden');
      return;
    }
    errorMsg.classList.add('hidden');

    // Capture email (fire and forget)
    fetch('https://formspree.io/f/xpwrbzzn', {
      method: 'POST',
      body: JSON.stringify({ email, resource: activeFile }),
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
    }).catch(() => {});

    // Trigger download
    const a = document.createElement('a');
    a.href = '/' + activeFile;
    a.download = activeFile;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);

    // Swap to the cross-sell success state instead of closing
    modalForm.classList.add('hidden');
    modalSuccess.classList.remove('hidden');
  });
</script>
