                <>
                  {i === prizes.length && <div class="prize-line">Prize line</div>}
                  <div class={isPrize ? 'lb-row' : 'lb-row is-out'}>
                    <div class="lb-head">
                      <span class="lb-name">
                        <span class="lb-rank">{i + 1}</span>
                        {s.name}
                        {isPrize && <span class="lb-prize">💰 ${prizes[i]}</span>}
                      </span>
                      <span class="lb-points">{s.points} <span>pts</span></span>
                    </div>
                    <div class="lb-track">
                      <div
                        class="lb-bar"
                        data-width={`${pct}%`}
                        style={`background: var(${barColors[i % barColors.length]});`}
                      ></div>
                    </div>
                  </div>
                </>
              );
            })}
            {hiddenCount > 0 && <div class="lb-more">more students...</div>}
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">Private cohort page &middot; please don't share outside the class.</div>
    </footer>

    <script is:inline>
      // Countdown to the September SAT — Saturday, September 12, 2026, 8:00 AM.
      (function () {
        var root = document.getElementById('countdown');
        if (!root) return;

        var target = new Date(2026, 8, 12, 8, 0, 0).getTime();
        var units = root.querySelector('.cd-units');
        var done = root.querySelector('.cd-done');
        var fields = {
          days: root.querySelector('[data-cd="days"]'),
          hours: root.querySelector('[data-cd="hours"]'),
          minutes: root.querySelector('[data-cd="minutes"]'),
          seconds: root.querySelector('[data-cd="seconds"]'),
        };

        function pad(n) {
          return n < 10 ? '0' + n : '' + n;
        }

        function tick() {
          var diff = target - Date.now();
          if (diff <= 0) {
            if (units) units.style.display = 'none';
            if (done) done.hidden = false;
            clearInterval(timer);
            return;
          }
          var s = Math.floor(diff / 1000);
          fields.days.textContent = Math.floor(s / 86400);
          fields.hours.textContent = pad(Math.floor((s % 86400) / 3600));
          fields.minutes.textContent = pad(Math.floor((s % 3600) / 60));
          fields.seconds.textContent = pad(s % 60);
        }

        tick();
        var timer = setInterval(tick, 1000);
      })();

      (function () {
        var section = document.getElementById('homework');
        if (!section) return;

        var group = section.querySelector('.toggle[data-toggle="plan"]');
        if (!group) return;

        group.addEventListener('click', function (e) {
          var btn = e.target.closest('button');
          if (!btn) return;
          group.querySelectorAll('button').forEach(function (b) {
            b.classList.remove('is-active');
          });
          btn.classList.add('is-active');
          section.setAttribute('data-plan', btn.getAttribute('data-plan'));
        });
      })();

      // Smooth accordion open/close (matches the FAQ on the masterclass page).
      // The <details> is kept permanently open so its body stays rendered;
      // we collapse/expand purely via max-height, which keeps the transition smooth.
      (function () {
        var items = document.querySelectorAll('details.week, details.res');
        items.forEach(function (detail) {
          var summary = detail.querySelector('summary');
          var body = detail.querySelector('.week-body, .res-body');
          if (!summary || !body) return;

          // Render content up front, start collapsed.
          detail.open = true;
          detail.classList.remove('is-open');
          body.style.maxHeight = '0px';

          summary.addEventListener('click', function (e) {
            e.preventDefault();
            var isOpen = detail.classList.contains('is-open');

            if (isOpen) {
              // Collapse: lock the current height, then animate to 0.
              body.style.maxHeight = body.scrollHeight + 'px';
              requestAnimationFrame(function () {
                body.style.maxHeight = '0px';
              });
              detail.classList.remove('is-open');
            } else {
              // Expand: animate to the content height, then release to none
              // so the panel can reflow (e.g. when the plan toggle changes).
              detail.classList.add('is-open');
              body.style.maxHeight = body.scrollHeight + 'px';
              body.addEventListener('transitionend', function handler(ev) {
                if (ev.propertyName !== 'max-height') return;
                if (detail.classList.contains('is-open')) {
                  body.style.maxHeight = 'none';
                }
                body.removeEventListener('transitionend', handler);
              });
            }
          });
        });
      })();

      // Progress bars: animate from 0 to their target width once on screen.
      (function () {
        var bars = document.querySelectorAll('.lb-bar');
        if (!bars.length) return;

        function fill() {
          bars.forEach(function (bar) {
            bar.style.width = bar.getAttribute('data-width') || '0%';
          });
        }

        if ('IntersectionObserver' in window) {
          var section = document.getElementById('progress');
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                fill();
                io.disconnect();
              }
            });
          }, { threshold: 0.25 });
          io.observe(section);
        } else {
          fill();
        }
      })();
    </script>
  </body>
</html>
