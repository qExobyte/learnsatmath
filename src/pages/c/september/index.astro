---
// Private cohort page — standalone (no shared Layout/Nav/Footer/analytics).
// Lives in src/pages for live reload; URL is /c/september/.

// ===== Student progress =====
// Edit this list to update the leaderboard. Each student is one row.
// `points` is the running total of participation points awarded in class.
// Names can be first names, initials, or nicknames — whatever students prefer.
// Rows are sorted by points automatically; bar lengths scale to the leader.
const students = [
  { name: 'Ramon', points: 1 },
  { name: 'Vivian', points: 0 },
  { name: 'Aarya', points: 4 },
  { name: 'Alex', points: 3 },
  { name: 'Anabelle', points: 3 },
  { name: 'Roman', points: 3 },
  { name: 'Ahmad', points: 4 },
  { name: 'Jessie', points: 3 },
  { name: 'Eshal', points: 4 },
  { name: 'Anthony', points: 5 },
  { name: 'Mia', points: 4 },
  { name: 'Adrian', points: 4 },
  { name: 'Amron', points: 4 },
  { name: 'Lilly', points: 5 },
];

// Cash prizes for the top finishers, in rank order (1st, 2nd, …). Top 5 win.
const prizes = [50, 40, 30, 20, 10];

// Palette cycled across the bars (matches the page's design tokens).
const barColors = ['--coral', '--electric', '--sky', '--mint', '--peach', '--lavender', '--rose'];

// Only the top rows are displayed; the rest are summarized in a note below the list.
const visibleCount = 10;
const sorted = [...students].sort((a, b) => b.points - a.points);
const visible = sorted.slice(0, visibleCount);
const hiddenCount = sorted.length - visible.length;
const maxPoints = Math.max(1, ...sorted.map((s) => s.points));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" href="/favicon-imprecise.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <title>SAT Math Masterclass | September 2026 Cohort</title>
    <style is:global>
      /* Design tokens mirrored from the site's Tailwind config */
      :root {
        --chalk: #F7F6F2;
        --ink: #141414;
        --ink-mid: #1b2a4a;
        --coral: #EE4E29;
        --electric: #FFE135;
        --sky: #C9E8FF;
        --mint: #C8F0D0;
        --peach: #FFE0CB;
        --rose: #FFD6D1;
        --lavender: #EDE9FF;
        --offset-sm: 3px 3px 0 0 var(--ink);
        --offset-hover: 1px 1px 0 0 var(--ink);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-size: 18px;
        scroll-behavior: smooth;
      }

      /* Laptop-height desktop viewports get a denser 16px root (matches Layout.astro). */
      @media (min-width: 1024px) and (max-height: 1000px) {
        html {
          font-size: 16px;
        }
      }

      body {
        margin: 0;
        background: var(--chalk);
        color: var(--ink);
        font-family: 'DM Sans', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }

      .wrap {
        max-width: 42rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ---- Header ---- */
      .masthead {
        background: var(--ink-mid);
        color: var(--chalk);
        padding: 4rem 0 3.5rem;
        border-bottom: 3px solid var(--ink);
        text-align: center;
      }

      .masthead h1 {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 2.5rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin: 0 0 0.5rem;
      }

      .masthead .sub {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0.25rem 0 0;
      }

      .masthead .sub .hl {
        background: var(--electric);
        color: var(--ink);
        padding: 0.1em 0.45em;
        display: inline-block;
        letter-spacing: -0.01em;
      }

      /* ---- Countdown ---- */
      .countdown {
        margin: 2rem auto 0;
        max-width: 30rem;
      }

      .cd-label {
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(247, 246, 242, 0.65);
        margin: 0 0 0.85rem;
      }

      .cd-units {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.6rem;
      }

      .cd-unit {
        background: var(--chalk);
        color: var(--ink);
        border: 2px solid var(--ink);
        border-radius: 0.75rem;
        box-shadow: var(--offset-sm);
        padding: 0.7rem 0.25rem 0.55rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
      }

      .cd-num {
        font-size: 2rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }

      .cd-tag {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(20, 20, 20, 0.55);
      }

      .cd-done {
        font-size: 1.1rem;
        font-weight: 800;
        margin: 0;
      }

      @media (max-width: 380px) {
        .cd-num {
          font-size: 1.6rem;
        }
      }

      /* ---- Sections ---- */
      section.block {
        padding: 3rem 0;
      }

      section.block + section.block {
        border-top: 2px dashed rgba(20, 20, 20, 0.15);
      }

      h2 {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
      }

      .lede {
        color: rgba(20, 20, 20, 0.6);
        font-weight: 600;
        margin: 0 0 1.5rem;
      }

      /* ---- Buttons (neobrutalist offset style) ---- */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        padding: 0.85rem 2rem;
        border-radius: 9999px;
        border: 2px solid var(--ink);
        box-shadow: var(--offset-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translate(3px, 3px);
        box-shadow: none;
      }

      .btn-coral {
        background: var(--coral);
        color: #fff;
      }

      .btn-ink {
        background: var(--ink);
        color: var(--chalk);
      }

      .btn-electric {
        background: var(--electric);
        color: var(--ink);
      }

      .btn-mint {
        background: var(--mint);
        color: var(--ink);
      }

      .btn-sky {
        background: var(--sky);
        color: var(--ink);
      }

      .btn-peach {
        background: var(--peach);
        color: var(--ink);
      }

      .btn-rose {
        background: var(--rose);
        color: var(--ink);
      }

      .btn-lavender {
        background: var(--lavender);
        color: var(--ink);
      }

      /* Resource action buttons: a touch smaller & lighter than the hero buttons */
      .res-body .btn {
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.65rem 1.5rem;
      }

      .btn .ico {
        width: 1.15em;
        height: 1.15em;
        flex-shrink: 0;
      }

      /* ---- Button group ---- */
      .btn-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
      }

      /* ---- Toggles (pill switches) ---- */
      #homework h2 {
        text-align: center;
      }

      .toggle-bar {
        display: flex;
        justify-content: center;
        margin-bottom: 1.75rem;
      }

      .toggle-wrap {
        position: relative;
        display: inline-flex;
      }

      .toggle {
        display: inline-flex;
        border: 2px solid var(--ink);
        border-radius: 9999px;
        padding: 0.25rem;
        background: #fff;
        box-shadow: var(--offset-sm);
      }

      .toggle button {
        font-family: 'DM Sans', system-ui, sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
        border: none;
        background: transparent;
        color: var(--ink);
        padding: 0.5rem 1.1rem;
        border-radius: 9999px;
        transition: background 0.2s ease, color 0.2s ease;
      }

      /* Plan toggle: standard active -> mint, advanced active -> rose */
      .toggle[data-toggle='plan'] button[data-plan='standard'].is-active {
        background: var(--mint);
        color: var(--ink);
      }

      .toggle[data-toggle='plan'] button[data-plan='advanced'].is-active {
        background: var(--rose);
        color: var(--ink);
      }

      /* ---- Tooltip ---- */
      .tip {
        position: absolute;
        left: 100%;
        top: 50%;
        transform: translateY(-50%);
        margin-left: 0.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.4rem;
        height: 1.4rem;
        border: 2px solid var(--ink);
        border-radius: 9999px;
        background: #fff;
        font-size: 0.75rem;
        font-weight: 900;
        color: var(--ink);
        cursor: help;
      }

      .tip .tip-bubble {
        position: absolute;
        bottom: calc(100% + 0.6rem);
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        width: 17rem;
        max-width: 70vw;
        background: var(--ink);
        color: var(--chalk);
        text-align: left;
        text-transform: none;
        letter-spacing: normal;
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1.45;
        padding: 0.75rem 0.9rem;
        border-radius: 0.6rem;
        box-shadow: var(--offset-sm);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.18s ease, transform 0.18s ease;
        z-index: 10;
      }

      .tip .tip-bubble::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 7px solid transparent;
        border-top-color: var(--ink);
      }

      .tip:hover .tip-bubble,
      .tip:focus-visible .tip-bubble {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }

      .tip .tip-bubble strong {
        color: var(--electric);
      }

      /* ---- Weekly assignments (details/summary) ---- */
      .weeks {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      details.week {
        background: #fff;
        border: 2px solid var(--ink);
        border-radius: 1rem;
        box-shadow: var(--offset-sm);
        overflow: hidden;
      }

      details.week > summary {
        list-style: none;
        cursor: pointer;
        padding: 1rem 1.25rem;
        font-weight: 800;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      details.week > summary::-webkit-details-marker {
        display: none;
      }

      details.week > summary .wk-tag {
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(20, 20, 20, 0.4);
      }

      details.week > summary .wk-date {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(20, 20, 20, 0.5);
        margin-top: 0.2rem;
      }

      details.week > summary .chevron {
        margin-left: auto;
        transition: transform 0.3s ease;
        flex-shrink: 0;
      }

      details.week.is-open > summary .chevron {
        transform: rotate(180deg);
      }

      .chevron svg {
        display: block;
        width: 1.2rem;
        height: 1.2rem;
      }

      details.week .week-body {
        max-height: 0;
        overflow: hidden;
        color: rgba(20, 20, 20, 0.75);
        font-weight: 500;
        transition: max-height 0.3s ease-in-out;
      }

      details.week .week-body .dd-inner {
        padding: 1rem 1.25rem 1.25rem;
        border-top: 2px dashed rgba(20, 20, 20, 0.12);
      }

      .week-body .hw {
        display: none;
        margin: 0;
      }

      #homework[data-plan='standard'] .hw[data-plan='standard'],
      #homework[data-plan='advanced'] .hw[data-plan='advanced'] {
        display: block;
      }

      /* Homework assignment tables */
      .hw-table {
        width: 100%;
        border-collapse: collapse;
      }

      .hw-table td {
        padding: 0.7rem 0;
        vertical-align: top;
        border-bottom: 1px solid rgba(20, 20, 20, 0.12);
      }

      .hw-table tr:first-child td {
        padding-top: 0;
      }

      .hw-table tr:last-child td {
        padding-bottom: 0;
        border-bottom: none;
      }

      .hw-task {
        font-weight: 700;
        color: var(--ink);
        padding-right: 1rem;
      }

      .hw-task a {
        color: var(--coral);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .hw-topics {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1.4;
        color: rgba(20, 20, 20, 0.7);
      }

      .hw-time {
        text-align: right;
        font-weight: 800;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        color: var(--ink);
      }

      /* Sub-headings inside each week panel (Sessions / Homework) */
      .hw-subhead {
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(20, 20, 20, 0.4);
        margin: 0 0 0.7rem;
      }

      .hw-subhead--hw {
        margin-top: 1.4rem;
      }

      /* Tinted container that sets the Sessions list apart from Homework */
      .sessions {
        background: rgba(201, 232, 255, 0.45);
        border-radius: 0.75rem;
        padding: 0.9rem 1.1rem;
      }

      .sessions .hw-subhead {
        margin-bottom: 0.6rem;
      }

      /* Prerequisite block that sits above Session 1 */
      .prereq {
        background: rgba(255, 214, 209, 0.5);
        border-radius: 0.75rem;
        padding: 0.9rem 1.1rem;
        margin-bottom: 0.9rem;
      }

      .prereq .hw-subhead {
        margin-bottom: 0.6rem;
        color: var(--coral);
      }

      /* Mid-class check-in (sits between weeks 3 and 4) */
      .checkin {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.7rem 1.25rem;
        padding: 0.5rem 0;
      }

      .checkin-title {
        font-size: 1.05rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        margin: 0;
      }

      .checkin-date {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(20, 20, 20, 0.5);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-top: 0.15rem;
      }

      .checkin .btn {
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.65rem 1.5rem;
      }

      /* ---- Resources ---- */
      #resources h2 {
        text-align: center;
      }

      #resources .lede {
        text-align: center;
      }

      .resources {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }

      details.res {
        border: 2px solid var(--ink);
        border-radius: 1rem;
        box-shadow: var(--offset-sm);
        overflow: hidden;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      details.res > summary {
        list-style: none;
        cursor: pointer;
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }

      details.res > summary::-webkit-details-marker {
        display: none;
      }

      .res-name {
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: -0.01em;
      }

      details.res > summary .chevron {
        margin-left: auto;
        flex-shrink: 0;
        transition: transform 0.2s ease;
      }

      details.res.is-open > summary .chevron {
        transform: rotate(180deg);
      }

      .res-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-in-out;
      }

      .res-body .dd-inner {
        padding: 1rem 1.25rem 1.25rem;
        border-top: 2px dashed rgba(20, 20, 20, 0.18);
      }

      .res-body p {
        margin: 0 0 1.1rem;
        font-weight: 500;
        color: rgba(20, 20, 20, 0.78);
      }

      .res-price {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink) !important;
        padding: 0.45rem 0.9rem;
        margin: 0 0 1.1rem !important;
        border-radius: 9999px;
        border: 2px solid var(--ink);
        background: var(--electric);
      }

      .res-emailed {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        font-weight: 700;
        padding: 0.7rem 1.2rem;
        border-radius: 9999px;
        border: 2px dashed var(--ink);
        background: rgba(255, 255, 255, 0.5);
      }

      .res-emailed .ico {
        width: 1.15em;
        height: 1.15em;
        flex-shrink: 0;
      }

      .res-sky > summary { background: var(--sky); }
      .res-mint > summary { background: var(--mint); }
      .res-peach > summary { background: var(--peach); }
      .res-lavender > summary { background: var(--lavender); }
      .res-rose > summary { background: var(--rose); }

      /* ---- Student progress ---- */
      #progress h2 {
        text-align: center;
      }

      #progress .lede {
        text-align: center;
      }

      .leaderboard {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      .lb-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }

      .lb-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .lb-name {
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }

      .lb-rank {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        flex-shrink: 0;
        font-size: 0.8rem;
        font-weight: 900;
        border: 2px solid var(--ink);
        border-radius: 9999px;
        background: #fff;
      }

      /* Prize money pill, shown only on the top-five rows. */
      .lb-prize {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        font-size: 0.75rem;
        font-weight: 900;
        padding: 0.1rem 0.5rem;
        border: 2px solid var(--ink);
        border-radius: 9999px;
        background: var(--chalk);
        white-space: nowrap;
      }

      .lb-points {
        font-weight: 800;
        font-size: 0.95rem;
        white-space: nowrap;
      }

      .lb-points span {
        font-weight: 600;
        color: rgba(20, 20, 20, 0.5);
        font-size: 0.8rem;
      }

      .lb-track {
        height: 1.6rem;
        border: 2px solid var(--ink);
        border-radius: 9999px;
        background: #fff;
        box-shadow: var(--offset-sm);
        overflow: hidden;
      }

      .lb-bar {
        height: 100%;
        border-radius: 9999px;
        /* width is set inline per-student; animate from 0 on load */
        width: 0;
        transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Rows outside the prize zone are present but quieter. */
      .lb-row.is-out {
        opacity: 0.78;
      }

      .lb-row.is-out .lb-track {
        height: 1.25rem;
        box-shadow: var(--offset-hover);
      }

      .lb-row.is-out .lb-name {
        font-size: 0.95rem;
      }

      .lb-row.is-out .lb-bar {
        opacity: 0.7;
      }

      /* The cash-prize cutoff: a dashed divider after rank 5. */
      .prize-line {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0.4rem 0;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(20, 20, 20, 0.55);
      }

      .prize-line::before,
      .prize-line::after {
        content: '';
        flex: 1;
        border-top: 2px dashed var(--ink);
        opacity: 0.5;
      }

      /* Note shown when only the top rows of the leaderboard are displayed. */
      .lb-more {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.4rem;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(20, 20, 20, 0.55);
      }

      .lb-more::before,
      .lb-more::after {
        content: '';
        flex: 1;
        border-top: 2px dashed var(--ink);
        opacity: 0.5;
      }

      footer {
        padding: 2.5rem 0 3rem;
        text-align: center;
        color: rgba(20, 20, 20, 0.4);
        font-size: 0.85rem;
        font-weight: 600;
      }

      @media (min-width: 1024px) {
        .masthead h1 {
          font-size: 3.25rem;
        }
        h2 {
          font-size: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <h1>SAT Math Masterclass</h1>
        <p class="sub"><span class="hl">September 2026</span></p>

        <div class="countdown" id="countdown" aria-label="Time until the September SAT">
          <p class="cd-label">Countdown to the September&nbsp;SAT</p>
          <div class="cd-units">
            <div class="cd-unit">
