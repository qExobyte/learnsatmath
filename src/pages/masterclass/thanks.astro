---
import Layout from '../../layouts/Layout.astro';
import Highlight from '../../components/Highlight.astro';
import { FREE_CALL_CALENDLY_URL } from '../../data/booking';
import { IS_FULL, NEXT_COHORT, ENROLL_STRIPE_URL } from '../../data/enrollment';
import { weeks, cohorts } from '../../data/schedule';

const SEP = cohorts.find((c) => c.id === 'sep')!;
const SEP_START = SEP.weekDates[0].split(' & ')[0]; // e.g. "Aug 8"

// Tally's "Redirect on completion" sends respondents here with their answers
// as query params: call, sat, sname, semail, pname, pemail, cur, goal, notes.
// The selected option of the final question ("call") picks the branch:
// Calendly booking, enrollment link, or plain thank-you.
//
// If this page ever loads inside the embed iframe on /masterclass, it breaks
// out to the top window so it always renders as its own full page.
---

<Layout title="Thanks" noindex>
  <script is:inline>
    // If loaded inside the Tally embed iframe, break out to the top window so
    // /thanks renders as its own full page.
    if (window.self !== window.top) window.top.location.href = window.location.href;
  </script>

  <section class="py-12 lg:py-16 bg-chalk">
    <!-- Confirmation / next step: centered hero (email + enroll variants) -->
    <div id="thanks-card" hidden class="max-w-2xl mx-auto px-6 lg:px-8">

            <div id="thanks-email" hidden class="text-center py-6">
              <div class="w-16 h-16 rounded-full bg-electric border-2 border-ink shadow-offset-sm flex items-center justify-center mx-auto mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </div>
              <h1 class="font-sans text-3xl font-black tracking-tight text-ink mb-3">Got it! Check your inbox soon.</h1>
              <p class="text-ink/80 font-semibold leading-relaxed">
                I look forward to helping you on your path to a 750+.
              </p>
            </div>

            <div id="thanks-enroll" hidden class="text-center py-6">
              <h1 class="font-sans text-3xl font-black tracking-tight text-ink mb-3">{!IS_FULL ? 'A 750+ awaits...' : 'Thanks for completing the form!'}</h1>
              {!IS_FULL ? (
                <>
                  <!-- Their SAT dates include September (the enrolling cohort) -->
                  <div data-enroll-now hidden>
                    <p class="text-xl text-ink/80 font-semibold leading-relaxed mb-6">
                      There are still spots open in the <Highlight>September</Highlight> cohort &mdash; classes start {SEP_START}.
                    </p>
                    <a
                      href={ENROLL_STRIPE_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-glint inline-flex items-center gap-2 bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-200 text-base tracking-wide"
                    >
                      Complete Enrollment
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </a>
                    <p class="text-sm text-ink/60 font-semibold mt-2">
                      ✓ Full refund available within 7 days of your first session.
                    </p>
                  </div>
                  <!-- Later test dates only: pitch September, offer to wait -->
                  <div data-enroll-later hidden>
                    <p class="text-lg lg:text-xl text-ink/80 font-semibold leading-relaxed mb-6">
                      Enrollment is open right now for the <Highlight>September</Highlight> cohort. Even with a later test date, <b>now</b> is the best time to start. Don't procrastinate!
                    </p>
                    <a
                      href={ENROLL_STRIPE_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-glint inline-block bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-200 text-base tracking-wide"
                    >
                      Join the September Cohort
                    </a>
                    <p class="text-sm text-ink/60 font-semibold mt-6">
                      ✓ Full refund available within 7 days of your first session.
                    </p>
                    <hr class="border-t-2 border-ink/10 my-6" />
                    <p class="text-sm text-ink/60 font-semibold">
                      Prefer a cohort closer to your test date? No action needed &mdash; you're on the list, and you'll get first access when it opens.
                    </p>
                  </div>
                </>
              ) : (
                <p class="text-ink/80 font-semibold leading-relaxed">
                  The current cohort is full &mdash; you're on the list for the next one, starting {NEXT_COHORT}. You'll get first access when enrollment opens.
                </p>
              )}
            </div>

    </div>

    <!-- Calendly booking: full-width, no card -->
    <div id="thanks-call" hidden class="max-w-5xl mx-auto px-6 lg:px-8">
      <h1 class="font-sans text-3xl lg:text-4xl font-black tracking-tight text-ink mb-3 text-center">Thanks for applying &mdash; let's talk!</h1>
      <p class="text-ink/80 font-semibold leading-relaxed text-center mb-6 max-w-2xl mx-auto">
        Pick a time below for your free intro call. We'll go over your experience, answer your questions, and figure out how best to help you reach your goal score.
      </p>
      <div id="calendly-embed" class="w-full" style="min-width:320px;height:1100px"></div>
    </div>
  </section>

  <!-- Full September schedule (revealed with the enroll branches) -->
  <section id="thanks-schedule" hidden class="py-12 lg:py-16 bg-sky">
    <div class="max-w-xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-2">Your September Schedule</h2>
        <p class="text-ink/60 text-xl font-semibold">5 weeks &middot; 10 live sessions</p>
      </div>

      <p class="text-center text-ink/60 text-xl font-semibold mb-8" set:html={SEP.time} />

      <div class="flex flex-col gap-4">
        {weeks.map((week, wi) => (
          <div class="relative bg-white border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm transition-transform duration-200 hover:-translate-y-0.5">
            <p class="flex justify-between gap-2 text-xs font-black uppercase tracking-widest text-ink/60 mb-1">
              <span>Week {week.number} &middot; {SEP.weekDates[wi]}</span>
              {week.number >= SEP.officeHoursFromWeek && <span class="text-ink/40">+ office hours</span>}
            </p>
            <p class="font-sans text-lg text-ink font-bold leading-snug">{week.name}</p>
          </div>
        ))}

        <!-- SAT -->
        <div class="relative bg-electric border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm">
          <p class="text-xs font-black uppercase tracking-widest text-ink/50 mb-1">SAT &middot; {SEP.satDate}</p>
          <p class="font-sans text-lg text-ink font-black">Good luck!</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import confetti from 'canvas-confetti';

    // Celebrate on arrival — skipped inside the /masterclass embed iframe,
    // where the parent card handles the thank-you UI, and on the plain
    // "Got it" branch (no call/enroll match — nothing to celebrate yet).
    // Low-score enrollers get the plain card (see the mode logic below),
    // so no confetti for them either.
    const q = new URLSearchParams(window.location.search);
    const call = q.get('call') || '';
    const nums = (q.get('cur') || '').match(/\d{3}/g);
    const lowScore = !!nums && Math.max(...nums.map(Number)) <= 520;
    const celebrate = /call/i.test(call) || (/enroll/i.test(call) && !lowScore);
    if (window.self === window.top && celebrate) {
      const colors = ['#EE4E29', '#FFE135', '#C9E8FF', '#C8F0D0', '#EDE9FF'];
      const fire = (angle: number, x: number) =>
        confetti({
          particleCount: 80,
          angle,
          spread: 60,
          startVelocity: 55,
          origin: { x, y: 0.7 },
          colors,
          disableForReducedMotion: true,
        });
      fire(60, 0);
      fire(120, 1);
      setTimeout(() => {
        fire(70, 0.1);
        fire(110, 0.9);
      }, 250);
    }
  </script>

  <script is:inline define:vars={{ FREE_CALL_CALENDLY_URL }}>
    (function () {
      var q = new URLSearchParams(window.location.search);
      var p = {
        call: q.get('call') || '',
        sname: q.get('sname') || '',
        semail: q.get('semail') || '',
        pname: q.get('pname') || '',
        pemail: q.get('pemail') || '',
        cur: q.get('cur') || '',
        goal: q.get('goal') || '',
        notes: q.get('notes') || '',
        sat: q.get('sat') || '',
      };

      // "Maybe - ...free call..." → call; "Yes - ...enroll!" → enroll;
      // anything else → plain thank-you.
      //
      // Mirrors the autoresponder's isLowScore(): at 520 or below the honest
      // recommendation is 1-on-1 (the follow-up email makes it), so the
      // enroll pitch downgrades to the plain "check your inbox" card.
      var nums = p.cur.match(/\d{3}/g);
      var lowScore = !!nums && Math.max.apply(null, nums.map(Number)) <= 520;
      var mode = /call/i.test(p.call) ? 'call'
        : /enroll/i.test(p.call) && !lowScore ? 'enroll'
        : 'email';

      // Still inside the embed iframe — break out to the top window; the
      // reloaded top-level page renders the full /thanks below.
      if (window.self !== window.top) {
        window.top.location.href = window.location.href;
        return;
      }

      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', { form: 'masterclass_interest' });
      }

      document.getElementById('thanks-' + mode).hidden = false;
      // The email/enroll variants live inside the centered card wrapper.
      if (mode !== 'call') document.getElementById('thanks-card').hidden = false;
      if (mode === 'enroll') document.getElementById('thanks-schedule').hidden = false;
      if (mode !== 'call') document.getElementById('thanks-card').hidden = false;
      if (mode === 'enroll') {
        // "Now" variant if their SAT dates include September (or the param
        // is missing); "later" pitch otherwise. Sub-divs only exist while
        // enrollment is open.
        var later = p.sat && !/sep/i.test(p.sat);
        var sub = document.querySelector(
          '#thanks-enroll ' + (later ? '[data-enroll-later]' : '[data-enroll-now]')
        );
        if (sub) sub.hidden = false;
      }
      if (mode !== 'call') return;

      var init = function () {
        window.Calendly.initInlineWidget({
          url: FREE_CALL_CALENDLY_URL + '?hide_gdpr_banner=1',
          parentElement: document.getElementById('calendly-embed'),
          prefill: {
            name: p.sname,
            email: p.semail,
            // Parent joins the calendar invite as a guest.
            guests: p.pemail && p.pemail !== p.semail ? [p.pemail] : [],
            // Calendly invitee questions, in order: Current Score, Goal
            // Score, "Anything else you'd like to add?".
            customAnswers: {
              a1: p.cur,
              a2: p.goal,
              a3: p.notes,
            },
          },
        });
      };
      if (window.Calendly) init();
      else {
        var s = document.createElement('script');
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.onload = init;
        document.body.appendChild(s);
      }

      // Calendly's iframe steals focus while booting, which makes the
      // browser scroll it into view. Pin the page to the top until the
      // widget has settled, then release.
      var pin = function () {
        if (window.pageYOffset) window.scrollTo(0, 0);
      };
      window.addEventListener('scroll', pin);
      var unpin = function () {
        window.removeEventListener('scroll', pin);
      };
      var unpinTimer = setTimeout(unpin, 5000);
      var widgetLoaded = false;

      // Calendly also autofocuses the Name input when the booking form step
      // loads, which scrolls the page down. Counter it by realigning to the
      // top of the booking section on step changes after the initial load.
      window.addEventListener('message', function (e) {
        if (String(e.origin).indexOf('https://calendly.com') !== 0) return;
        var ev = e.data && e.data.event;
        if (ev === 'calendly.date_and_time_selected' || ev === 'calendly.event_type_viewed') {
          if (!widgetLoaded) {
            // Widget booted — give its autofocus a moment, then release.
            widgetLoaded = true;
            clearTimeout(unpinTimer);
            setTimeout(unpin, 800);
            return;
          }
          var el = document.getElementById('thanks-call');
          if (el) {
            setTimeout(function () {
              el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          }
        }
      });
    })();
  </script>
</Layout>

<style>
  /* Periodic shine sweep across the enroll CTA (matches /masterclass) */
  .btn-glint {
    position: relative;
    overflow: hidden;
  }

  .btn-glint::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 45%;
    background: linear-gradient(
      105deg,
      transparent,
      rgba(255, 255, 255, 0.55) 50%,
      transparent
    );
    transform: translateX(-150%) skewX(-20deg);
    animation: glint 4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes glint {
    0% {
      transform: translateX(-150%) skewX(-20deg);
    }
    35%,
    100% {
      transform: translateX(400%) skewX(-20deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-glint::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
