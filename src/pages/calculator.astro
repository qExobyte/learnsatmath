---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prep Hours Calculator" description="Estimate how many hours per week you need to study to reach your SAT Math goal score by test day.">

  <style>
    input[type=range] {
      width: 100%;
      accent-color: #378ADD;
      cursor: pointer;
      height: 6px;
    }
  </style>

  <!-- Masterclass banner (shown conditionally by JS) -->
  <div id="masterclass-banner" class="overflow-hidden transition-[max-height] duration-500 ease-in-out" style="max-height:0">
    <div class="bg-electric border-b-2 border-ink px-6 py-4">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="font-sans font-extrabold text-ink text-center sm:text-left">With your timeline and goal, the <span class="underline decoration-2 underline-offset-2">SAT Math Masterclass</span> is your best path forward.</p>
        <a
          href="/masterclass"
          class="flex-shrink-0 bg-white text-ink font-bold py-2.5 px-6 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-sm"
        >
          Join the Masterclass →
        </a>
      </div>
    </div>
  </div>

  <!-- Calculator -->
  <section class="bg-peach py-8">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 mb-6">
      <h1 class="font-sans text-3xl font-black text-ink tracking-tight text-center">Score Improvement Calculator</h1>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8">

      <!-- ── Inputs ── -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">

        <!-- Scores card -->
        <div class="bg-white border-2 border-ink rounded-2xl p-5 shadow-offset-sm">
          <div class="space-y-4">

            <div>
              <div class="flex items-baseline justify-between mb-2">
                <label for="curr" class="font-sans text-xs font-bold text-ink/60 uppercase tracking-widest">Current score</label>
                <span id="cv" class="font-sans font-black text-xl text-ink">600</span>
              </div>
              <input type="range" min="400" max="790" step="10" value="600" id="curr">
              <div class="flex justify-between text-xs text-ink/25 mt-1 font-medium select-none">
                <span>400</span><span>790</span>
              </div>
            </div>

            <div>
              <div class="flex items-baseline justify-between mb-2">
                <label for="goal" class="font-sans text-xs font-bold text-ink/60 uppercase tracking-widest">Goal score</label>
                <span id="gv" class="font-sans font-black text-xl text-ink">700</span>
              </div>
              <input type="range" min="420" max="800" step="10" value="700" id="goal">
              <div class="flex justify-between text-xs text-ink/25 mt-1 font-medium select-none">
                <span>420</span><span>800</span>
              </div>
            </div>

          </div>
        </div>

        <!-- Context card -->
        <div class="bg-white border-2 border-ink rounded-2xl p-5 shadow-offset-sm">
          <div class="space-y-3">

            <div>
              <label for="wks" class="font-sans text-xs font-bold text-ink/60 uppercase tracking-widest block mb-1.5">Weeks to test</label>
              <select id="wks" class="font-sans text-sm px-3 py-2 rounded-lg border-2 border-ink/20 bg-white text-ink cursor-pointer w-full focus:outline-none focus:border-ink/50 transition-colors">
                <option value="1">1 week</option>
                <option value="2">2 weeks</option>
                <option value="3">3 weeks</option>
                <option value="4" selected>4 weeks</option>
                <option value="6">6 weeks</option>
                <option value="8">8 weeks</option>
                <option value="12">12+ weeks</option>
              </select>
            </div>

            <div>
              <label for="prior" class="font-sans text-xs font-bold text-ink/60 uppercase tracking-widest block mb-1.5">Prior prep</label>
              <select id="prior" class="font-sans text-sm px-3 py-2 rounded-lg border-2 border-ink/20 bg-white text-ink cursor-pointer w-full focus:outline-none focus:border-ink/50 transition-colors">
                <option value="none">None</option>
                <option value="moderate" selected>Moderate — some prior work</option>
                <option value="extensive">Extensive — heavily prepped already</option>
              </select>
            </div>

            <div>
              <label for="desmos" class="font-sans text-xs font-bold text-ink/60 uppercase tracking-widest block mb-1.5">Prior Desmos usage</label>
              <select id="desmos" class="font-sans text-sm px-3 py-2 rounded-lg border-2 border-ink/20 bg-white text-ink cursor-pointer w-full focus:outline-none focus:border-ink/50 transition-colors">
                <option value="none">None</option>
                <option value="moderate" selected>Moderate — using on some problems</option>
                <option value="heavy">Heavy — understand almost every trick</option>
              </select>
            </div>

          </div>
        </div>

      </div>

      <!-- ── Metric cards ── -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">

        <div class="bg-white border-2 border-ink rounded-xl p-4 shadow-offset-sm transition-transform duration-150 hover:scale-105 cursor-default">
          <p class="font-sans text-[9px] font-bold uppercase tracking-widest text-ink/40 mb-2">hrs / week</p>
          <p class="font-sans text-2xl font-black text-ink leading-none" id="m-hpw">—</p>
        </div>

        <div class="bg-white border-2 border-ink rounded-xl p-4 shadow-offset-sm transition-transform duration-150 hover:scale-105 cursor-default">
          <p class="font-sans text-[9px] font-bold uppercase tracking-widest text-ink/40 mb-2">total hours</p>
          <p class="font-sans text-2xl font-black text-ink leading-none" id="m-h">—</p>
        </div>

        <div class="bg-white border-2 border-ink rounded-xl p-4 shadow-offset-sm transition-transform duration-150 hover:scale-105 cursor-default">
          <p class="font-sans text-[9px] font-bold uppercase tracking-widest text-ink/40 mb-2">assessment</p>
          <p class="font-sans text-xl font-black leading-tight" id="m-stat">—</p>
        </div>

        <div class="bg-white border-2 border-ink rounded-xl p-4 shadow-offset-sm transition-transform duration-150 hover:scale-105 cursor-default">
          <p class="font-sans text-[9px] font-bold uppercase tracking-widest text-ink/40 mb-2">problem difficulty</p>
          <p class="font-sans text-xl font-black leading-tight" id="m-diff">—</p>
        </div>

      </div>

      <!-- ── Chart ── -->
      <div class="bg-white border-2 border-ink rounded-2xl p-5 shadow-offset-sm mb-6">

        <!-- Legend -->
        <div class="flex flex-wrap gap-4 mb-3 font-sans text-[11px] text-ink/50">
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-5 h-0.5 rounded bg-[#378ADD]"></span>
            <span>Cumulative gain</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-5" style="border-top: 1.5px dashed rgba(20,20,20,0.4); height:0;"></span>
            <span>Goal &amp; hours needed</span>
          </div>
          <div class="flex items-center gap-1.5" id="kink-legend" style="display:none;">
            <span class="inline-block w-5 h-0.5 rounded bg-[#d97706]"></span>
            <span>Desmos bonus ends (50 pt mark)</span>
          </div>
        </div>

        <div class="relative w-full" style="height: 195px;">
          <canvas id="mainChart"></canvas>
        </div>

      </div>

      <!-- ── CTA ── -->
      <div class="flex flex-col items-center gap-3 mb-6">
        <p class="font-sans text-base font-bold text-ink">Want to see this plan in action?</p>
        <a
          href="/tutoring#pricing"
          class="bg-coral text-white text-sm font-bold px-5 py-2.5 rounded-xl border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          Book a strategy call
        </a>
      </div>

    </div>
  </section>

</Layout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script is:inline>
// higher TAU means more linear
// specifically, tau is the number of hours of prep for progress rate to halve
const TAU = 40;
// maximum points per hour
const CAP = 10;
// higher YINT means easier
const YINT = 650;  
// higher = more generous gains close to a perfect score
const FLOOR_SLOPE = 1;
const r0fn = s => {
  const expPart = YINT * Math.exp(-0.00732 * s);
  const floor = 0.5 + FLOOR_SLOPE * Math.max(0, (s - 700) / 100);
  return Math.min(CAP, expPart + floor);
};
// penalties for prior prep
const PRIOR  = { none: 1.0, moderate: 0.9, extensive: 0.70 };
const DESMOS = { none: 1.3, moderate: 1.0, heavy: 0.9 };
const multFor = w => w <= 1 ? 0.8 : w <= 2 ? 0.9 : 1.0;
const DT = 0.05;

function simulate(score, goal, M, priorDecay, D) {
  const G = Math.max(0, goal - score);
  let t = 0, gain = 0;
  let H = null, H1 = null;
  const pts = [{ x: 0, y: 0 }];
  let lastRecord = 0;

  for (let i = 0; i < 6000; i++) {
    const currentScore = score + gain;
    const dD = gain < 50 ? D : 1.0;
    const rate = r0fn(currentScore) * M * priorDecay * Math.pow(2, -t / TAU) * dD;
    const newGain = gain + rate * DT;
    const newT = t + DT;

    if (H1 === null && D !== 1.0 && gain < 50 && newGain >= 50) {
      H1 = t + (50 - gain) / rate;
    }
    if (H === null && G > 0 && gain < G && newGain >= G) {
      H = t + (G - gain) / rate;
    }

    gain = newGain;
    t = newT;

    if (t - lastRecord >= 0.49) {
      pts.push({ x: +t.toFixed(1), y: +gain.toFixed(2) });
      lastRecord = t;
    }

    if (rate < 0.003) break;
  }

  if (pts[pts.length - 1].x < t) pts.push({ x: +t.toFixed(1), y: +gain.toFixed(2) });

  const ceilScore = Math.min(800, Math.round(score + gain));
  return { pts, H, H1, ceilScore, ceilGain: gain };
}

const ctx = document.getElementById('mainChart').getContext('2d');
let chart = null;

function buildChart(pts, G, H, H1, xMax, score, statusColor, D) {
  if (chart) chart.destroy();

  const displayPts = pts.filter(p => p.x <= xMax + 0.5);
  const tc = 'rgba(0,0,0,0.32)';
  const gc = 'rgba(0,0,0,0.05)';
  const showKink = H1 !== null && D !== 1.0 && H1 <= xMax;

  chart = new window.Chart(ctx, {
    type: 'line',
    data: { datasets: [{ data: displayPts, borderColor: '#378ADD', borderWidth: 2.5,
        pointRadius: 0, tension: 0.2, fill: false }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: {
          title: i => `Hour ${Math.round(i[0].raw.x)}`,
          label: i => `Score: ~${Math.round(score + i[0].raw.y)} (gain +${Math.round(i[0].raw.y)})`,
        }},
      },
      scales: {
        x: { type: 'linear', min: 0, max: xMax, border: { display: false },
          ticks: { color: tc, font: { size: 11 }, maxTicksLimit: 7, callback: v => `${Math.round(v)}h` },
          grid: { color: gc } },
        y: { border: { display: false },
          ticks: { color: tc, font: { size: 11 }, maxTicksLimit: 5, callback: v => `+${Math.round(v)}` },
          grid: { color: gc } },
      },
    },
    plugins: [{
      id: 'overlays',
      afterDraw(c) {
        const { ctx: cx, scales: { x, y } } = c;
        cx.save();

        cx.strokeStyle = statusColor + 'bb';
        cx.lineWidth = 1.5;
        cx.setLineDash([5, 4]);
        const yGoalPx = y.getPixelForValue(G);
        cx.beginPath(); cx.moveTo(x.left, yGoalPx); cx.lineTo(x.right, yGoalPx); cx.stroke();
        if (H !== null && H <= xMax) {
          const xHPx = x.getPixelForValue(H);
          cx.beginPath(); cx.moveTo(xHPx, y.top); cx.lineTo(xHPx, y.bottom); cx.stroke();
        }

        if (showKink) {
          cx.strokeStyle = '#d97706aa';
          cx.lineWidth = 1;
          cx.setLineDash([3, 3]);
          const xK = x.getPixelForValue(H1);
          const yK = y.getPixelForValue(50);
          cx.beginPath(); cx.moveTo(xK, y.top); cx.lineTo(xK, yK); cx.stroke();
          cx.beginPath(); cx.moveTo(x.left, yK); cx.lineTo(xK, yK); cx.stroke();
        }

        cx.setLineDash([]);
        cx.font = '11px "DM Sans", system-ui, sans-serif';
        cx.fillStyle = statusColor;
        cx.fillText(`goal: +${Math.round(G)} pts`, x.left + 6, yGoalPx - 6);

        cx.restore();
      },
    }],
  });
}

function update() {
  const score     = +document.getElementById('curr').value;
  const goal      = +document.getElementById('goal').value;
  const weeks     = +document.getElementById('wks').value;
  const priorKey  = document.getElementById('prior').value;
  const dKey      = document.getElementById('desmos').value;

  document.getElementById('cv').textContent = score;
  document.getElementById('gv').textContent = goal;

  const banner = document.getElementById('masterclass-banner');
  if (goal >= 750 && weeks >= 4) {
    banner.style.maxHeight = banner.scrollHeight + 'px';
  } else {
    banner.style.maxHeight = '0px';
  }

  const G = goal - score;
  if (G <= 0) {
    ['m-hpw','m-h','m-diff','m-stat'].forEach(id => {
      document.getElementById(id).textContent = '—';
      document.getElementById(id).style.color = '#141414';
    });
    return;
  }

  const M          = multFor(weeks);
  const priorDecay = PRIOR[priorKey];
  const D          = DESMOS[dKey];
  const { pts, H, H1 } = simulate(score, goal, M, priorDecay, D);

  const hpw = H !== null ? H / weeks : null;

  let status, statusColor;
  if (H === null)     { status = 'Not feasible';   statusColor = '#b91c1c'; }
  else if (hpw > 15)  { status = 'Very intensive'; statusColor = '#ef4444'; }
  else if (hpw > 7)   { status = 'Intensive';      statusColor = '#d97706'; }
  else                { status = 'Feasible';        statusColor = '#16a34a'; }

  const hpwEl = document.getElementById('m-hpw');
  hpwEl.textContent = hpw !== null ? hpw.toFixed(1) : '—';
  hpwEl.style.color = hpw !== null ? statusColor : '#141414';
  document.getElementById('m-h').textContent = H !== null ? Math.round(H) : '—';

  let diffLabel, diffColor;
  if (score < 450)       { diffLabel = 'Easy';        diffColor = '#16a34a'; }
  else if (score <= 490) { diffLabel = 'Easy / Med';  diffColor = '#16a34a'; }
  else if (score <= 600) { diffLabel = 'Medium';      diffColor = '#d97706'; }
  else if (score <= 640) { diffLabel = 'Med / Hard';  diffColor = '#d97706'; }
  else                   { diffLabel = 'Hard';        diffColor = '#ef4444'; }
  const diffEl = document.getElementById('m-diff');
  diffEl.textContent = diffLabel;
  diffEl.style.color = diffColor;

  const statEl = document.getElementById('m-stat');
  statEl.textContent  = status;
  statEl.style.color  = statusColor;

  document.getElementById('kink-legend').style.display = D !== 1.0 ? 'flex' : 'none';

  const xMax = H !== null ? Math.min(H * 1.8, 110) : 100;
  buildChart(pts, G, H, H1, xMax, score, statusColor, D);
}

['curr','goal','wks','prior','desmos'].forEach(id =>
  document.getElementById(id).addEventListener('change', update));

['curr','goal'].forEach(id =>
  document.getElementById(id).addEventListener('input', update));

update();
</script>
