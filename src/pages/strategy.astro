---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strategy" description="SAT Math strategy guides and tips from Eric.">
  <section class="bg-navy text-white py-20 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="font-serif text-4xl lg:text-5xl tracking-tight mb-4">Strategy</h1>
      <p class="text-blue-200 text-lg">Frameworks for tackling the digital SAT.</p>
    </div>
  </section>
  <section class="py-16 bg-ivory">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <p class="text-gray-500 text-lg">Strategy guides coming soon.</p>
    </div>
  </section>
</Layout>
