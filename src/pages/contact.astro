---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Eric about 1-on-1 tutoring or general questions.">
  <section class="bg-navy text-white py-20 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="font-serif text-4xl lg:text-5xl tracking-tight mb-4">Contact</h1>
      <p class="text-blue-200 text-lg">Questions about 1-on-1 sessions or anything else.</p>
    </div>
  </section>
  <section class="py-16 bg-ivory">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <p class="text-gray-500 text-lg mb-6">Contact form coming soon. For now, reach out directly via the Masterclass waitlist form.</p>
      <a
        href="https://forms.gle/5njHK2AFm8A3pTsb8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cta text-white font-semibold px-8 py-3 rounded hover:bg-orange-700 transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
