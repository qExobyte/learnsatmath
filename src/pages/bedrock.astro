---
import Layout from '../layouts/Layout.astro';
import { bedrockProblems } from '../data/bedrockProblems';

const PRO_URL = 'https://www.bedrockprep.com/pro';
const FREE_URL = 'https://www.bedrockprep.com/problems';

// Difficulty → tile fill/text, copied verbatim from the platform's
// DIFFICULTY_TILE_STYLES (bedrock lib/progress.ts), so difficulty reads in
// the same color language as the Bedrock 125 and question-bank pages.
const diffBg: Record<string, string> = {
  easy: 'bg-green-100 text-green-700',
  medium: 'bg-amber-100 text-amber-700',
  hard: 'bg-red-100 text-red-600',
};


// The variations showcase: q82 Arc Length, the bank's deepest family (10
// authored variations, easy → hard). Letters/difficulties mirror the real
// v82b–v82k files in the Bedrock repo.
const arcLength = bedrockProblems.find((p) => p.n === 82)!;
const variationChips = [
  { label: '82b', d: 'easy' },
  { label: '82c', d: 'easy' },
  { label: '82d', d: 'easy' },
  { label: '82e', d: 'easy' },
  { label: '82f', d: 'easy' },
  { label: '82g', d: 'medium' },
  { label: '82h', d: 'medium' },
  { label: '82i', d: 'medium' },
  { label: '82j', d: 'medium' },
  { label: '82k', d: 'hard' },
];

// Reel clips: 6-second 960×540 H.264 excerpts of real Bedrock solution videos,
// cut from the full-quality Mux streams (signed downloads via the Bedrock
// repo's keys) at the offsets noted below. The Drive "raw mp4" exports use the
// bank's OLD numbering — always re-rip from Mux by the playback ID in
// questions/bedrock-100/qNNN.md frontmatter, never trust qNNN filenames.
const reelClips = [
  { src: '/bedrock/clip-q015.mp4', name: 'Systems of Inequalities' }, // t=36
  { src: '/bedrock/clip-q008.mp4', name: 'Custom Regressions' }, // t=46
  { src: '/bedrock/clip-q069.mp4', name: 'Unit Circle' }, // t=22
  { src: '/bedrock/clip-q041.mp4', name: 'Shifting Exponents' }, // t=14
  { src: '/bedrock/clip-q094.mp4', name: 'Area from 3 Points' }, // t=134
  { src: '/bedrock/clip-q101.mp4', name: 'Cone Enclosed in a Sphere' }, // t=137
  { src: '/bedrock/clip-q061.mp4', name: 'Vertex Form' }, // t=16
  { src: '/bedrock/clip-q085.mp4', name: 'Quadrilateral from Tangent Lines' }, // t=20
];
---

<Layout
  title="Bedrock"
  description="Bedrock: 125 problems covering the entire SAT Math, hundreds of variations of each, and a video lesson for every one. Try it free."
>
  <!-- ───────────────────────── Hero ───────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 pt-20 pb-12 sm:pt-28 sm:pb-16 text-center">
      <!-- Lockup: rock mark + wordmark -->
      <h1 class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <svg
          id="bp-logo"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 96 96"
          fill="none"
          aria-hidden="true"
          class="h-24 w-24 sm:h-32 sm:w-32"
        >
          <g stroke="#141414" stroke-linejoin="round" stroke-linecap="round">
            <path d="M80 30 L86 56 L70 82 L32 84 L46 48 Z" fill="#C63C1E" stroke-width="3" />
            <path d="M18 32 L46 48 L32 84 L12 58 Z" fill="#EE4E29" stroke-width="3" />
            <path d="M18 32 L36 16 L58 12 L80 30 L46 48 Z" fill="#FFE0CB" stroke-width="3" />
            <path d="M36 16 L58 12 L80 30 L86 56 L70 82 L32 84 L12 58 L18 32 Z" fill="none" stroke-width="3.5" />
          </g>
        </svg>
        <span id="bp-wordmark" class="bp-shine font-sans font-black tracking-tight text-6xl sm:text-8xl">Bedrock</span>
      </h1>

      <p id="bp-tagline" class="mt-6 font-sans text-xl sm:text-2xl font-bold text-ink/70">
        An SAT Math platform built for results.
      </p>

      <div id="bp-hero-cta" class="mt-10 flex flex-col items-center gap-4">
        <a
          href={PRO_URL}
          class="inline-flex items-center gap-2 bg-coral text-white font-bold px-10 py-5 rounded-full border-2 border-ink shadow-offset-md hover:shadow-none hover:translate-x-[5px] hover:translate-y-[5px] transition-all duration-200 text-xl"
        >
          Get Started &rarr;
        </a>
        <a href={FREE_URL} class="font-sans text-sm font-semibold text-ink/50 hover:text-coral transition-colors">
          or try it free &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────────────── 1 · The 125 problems ─────────────────── -->
  <section class="py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Left: lockup, tagline, and the top of the problem grid -->
        <div class="text-center lg:text-left">
          <h2 class="sr-only">The Bedrock 125</h2>
          <!-- The Bedrock 125 lockup, ported from the platform's Bedrock125Lockup
               component (same bar geometry/colors; DM Sans is loaded here too). -->
          <svg
            id="bp-lockup"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 336 120"
            fill="none"
            role="img"
            aria-label="The Bedrock 125"
            class="reveal mx-auto lg:mx-0 h-auto w-[280px] sm:w-[336px]"
          >
            <g stroke="#141414" stroke-width="3" stroke-linejoin="round">
              <rect class="bp-bar" x="2" y="62" width="17" height="56" rx="3" fill="#16A34A" />
              <rect class="bp-bar" x="29" y="42" width="17" height="76" rx="3" fill="#F59E0B" />
              <rect class="bp-bar" x="56" y="22" width="17" height="96" rx="3" fill="#EE4E29" />
              <rect class="bp-bar" x="83" y="2" width="17" height="116" rx="3" fill="#9333EA" />
            </g>
            <text x="130" y="34" font-family="'DM Sans', system-ui, sans-serif" font-weight="800" font-size="15" letter-spacing="1.1" fill="#141414">THE BEDROCK</text>
            <text id="bp-count" x="127" y="107" font-family="'DM Sans', system-ui, sans-serif" font-weight="900" font-size="76" letter-spacing="-2" fill="#141414">125</text>
          </svg>
          <p class="reveal mt-4 font-sans text-lg font-medium text-ink/70">
            Every problem on the SAT Math falls into one of 125 problem types. Drill these and you&rsquo;re at a perfect score.
          </p>

          <!-- The top of the grid: 3 full rows, then a fading 4th that says
               "there are more" (the mask fades the bottom of the container). -->
          <div class="bp-grid-mask mt-10">
            <div id="bp-grid" class="bp-grid" aria-label="The first 40 of the 125 Bedrock problems, colored by difficulty">
              {bedrockProblems.slice(0, 40).map((p) => (
                <div
                  class={`bp-tile ${diffBg[p.d]} aspect-square rounded-md sm:rounded-lg border-2 border-ink shadow-offset-sm hover:shadow-offset-hover hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150 flex items-center justify-center font-sans font-black text-[10px] sm:text-[12px] select-none`}
                  title={`#${p.n} ${p.name} — ${p.d} · ${p.v} variations`}
                >
                  {p.n}
                </div>
              ))}
            </div>
          </div>

          <a
            href={FREE_URL}
            class="reveal mt-8 inline-flex items-center gap-2 font-sans font-bold text-ink hover:text-coral transition-colors"
          >
            Try them free &rarr;
          </a>
        </div>

        <!-- Right: the platform in action — answering #47 Integer Factors
             (screen recording, same autoplay-loop idiom as the sizzle reels) -->
        <div class="reveal">
          <video
            src="/bedrock/bedrock125-demo.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full rounded-2xl border-2 border-ink bg-white shadow-offset-md"
            aria-label="Answering problem 47, Integer Factors, on Bedrock"
          ></video>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────── 2 · The videos ─────────────────── -->
  <section class="py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="reveal font-sans text-4xl sm:text-6xl font-black tracking-tight">A video lesson for every problem.</h2>
      <p class="reveal mt-4 flex items-center justify-center gap-3 font-sans text-lg sm:text-xl font-semibold text-ink/60">
        <img
          src="/eric.jpg"
          alt="Eric Wolpert"
          class="h-10 w-10 sm:h-12 sm:w-12 rounded-full border-2 border-ink object-cover"
        />
        <span><span class="text-coral">127</span> lessons by Eric, edited down to be efficient.</span>
      </p>
    </div>

    <!-- Full-bleed conveyor of real solution-video clips -->
    <div class="mt-14 w-full overflow-hidden pb-1">
      <div class="bp-reel flex w-max">
        {[0, 1].map((half) => (
          <div class="flex shrink-0 gap-6 pr-6" aria-hidden={half === 1}>
            {reelClips.map((clip) => (
              <div class="aspect-video w-72 sm:w-96 shrink-0 overflow-hidden rounded-2xl border-2 border-ink bg-white shadow-offset-sm">
                <video
                  src={clip.src}
                  autoplay
                  loop
                  muted
                  playsinline
                  aria-label={half === 0 ? `Bedrock video lesson clip: ${clip.name}` : undefined}
                  class="h-full w-full object-cover"
                ></video>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────── 3 · The variations ─────────────────── -->
  <section class="py-12 sm:py-16 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="reveal font-sans text-4xl sm:text-6xl font-black tracking-tight">600+ variations across all problem types</h2>
      <p class="reveal mt-4 font-sans text-lg sm:text-xl font-semibold text-ink/60">
        Drill each problem type until you master it.
      </p>

      <!-- #82 leans left, then re-centers, shaking its b–k variation tiles
           out into the row beside it — same tile language as the 125 grid. -->
      <div id="bp-var-stage" class="mt-14 flex flex-wrap items-center justify-center gap-2 sm:gap-2.5">
        <span class="font-sans text-xl sm:text-2xl font-black tracking-tight mr-2 sm:mr-3">{arcLength.name}</span>
        <div
          id="bp-var-base"
          class={`${diffBg[arcLength.d]} h-11 w-11 sm:h-14 sm:w-14 rounded-lg sm:rounded-xl border-2 border-ink shadow-offset-sm hover:shadow-offset-hover hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150 flex items-center justify-center font-sans font-black text-xs sm:text-sm select-none`}
          title={`#82 ${arcLength.name} — ${arcLength.d} · ${arcLength.v} variations`}
        >
          82
        </div>
        {variationChips.map((c) => (
          <div
            class={`bp-var-chip ${diffBg[c.d]} h-11 w-11 sm:h-14 sm:w-14 rounded-lg sm:rounded-xl border-2 border-ink shadow-offset-sm hover:shadow-offset-hover hover:translate-x-[2px] hover:translate-y-[2px] transition-all duration-150 flex items-center justify-center font-sans font-black text-xs sm:text-sm select-none`}
            title={`${arcLength.name} — variation ${c.label.slice(-1)} (${c.d})`}
          >
            {c.label}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────── Final CTA ─────────────────── -->
  <section class="pt-4 pb-20 sm:pt-8 sm:pb-24">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 text-center">
      <div class="reveal flex flex-col items-center gap-4">
        <a
          href={PRO_URL}
          class="inline-flex items-center gap-2 bg-coral text-white font-bold px-10 py-5 rounded-full border-2 border-ink shadow-offset-md hover:shadow-none hover:translate-x-[5px] hover:translate-y-[5px] transition-all duration-200 text-xl"
        >
          Get Started &rarr;
        </a>
        <a href={FREE_URL} class="font-sans text-sm font-semibold text-ink/50 hover:text-coral transition-colors">
          or try it free &rarr;
        </a>
      </div>
    </div>
  </section>

  <style is:global>
    /* Wordmark glint: a white band swept across the glyphs by GSAP. The band
       rides a no-repeat gradient over a solid base color, both clipped to the
       text — any resting background-position just shows the base color. */
    .bp-shine {
      background-color: #141414;
      background-image: linear-gradient(110deg, rgba(255, 255, 255, 0) 42%, rgba(255, 255, 255, 0.85) 50%, rgba(255, 255, 255, 0) 58%);
      background-size: 250% 100%;
      background-position: 150% 0;
      background-repeat: no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* Problem-grid teaser: always 10 columns, so the 40 tiles land as 3 full
       rows plus the fading 4th. The 8px gap leaves room for each tile's 3px
       offset shadow. */
    .bp-grid {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }

    /* Fade out the bottom row — "there are more where these came from". */
    .bp-grid-mask {
      -webkit-mask-image: linear-gradient(180deg, #000 68%, transparent 99%);
      mask-image: linear-gradient(180deg, #000 68%, transparent 99%);
    }

    /* Pre-hide animated elements only when JS runs and motion is allowed,
       same contract as Layout's .reveal. GSAP animates them in. */
    @media (prefers-reduced-motion: no-preference) {
      html.js .bp-tile,
      html.js .bp-bar,
      html.js .bp-var-chip,
      html.js #bp-logo,
      html.js #bp-wordmark,
      html.js #bp-tagline,
      html.js #bp-hero-cta {
        opacity: 0;
      }
    }

    /* Video reel conveyor: two identical halves slide -50% on loop. */
    .bp-reel { animation: bp-reel 48s linear infinite; }
    .bp-reel:hover { animation-play-state: paused; }
    @keyframes bp-reel {
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .bp-reel { animation: none; }
    }
  </style>

  <script>
    import { gsap, ScrollTrigger, prefersReducedMotion } from '../scripts/motion';

    if (!prefersReducedMotion()) {
      // ── Hero entrance ──
      const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
      intro
        .fromTo('#bp-logo', { opacity: 0, scale: 0, rotation: -12 }, { opacity: 1, scale: 1, rotation: 0, duration: 0.7, ease: 'back.out(1.6)' })
        .fromTo('#bp-wordmark', { opacity: 0, y: 28 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.35')
        .fromTo('#bp-tagline', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.25')
        .fromTo('#bp-hero-cta', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5 }, '-=0.3');

      // Recurring glint across the wordmark.
      gsap.fromTo(
        '.bp-shine',
        { backgroundPosition: '150% 0' },
        { backgroundPosition: '-50% 0', duration: 1.3, ease: 'power2.inOut', repeat: -1, repeatDelay: 2.6, delay: 1.2 },
      );

      // ── Bedrock 125 lockup: difficulty bars rise, the numeral counts up ──
      const lockup = document.getElementById('bp-lockup');
      const count = document.getElementById('bp-count');
      if (lockup) {
        ScrollTrigger.create({
          trigger: lockup,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            // Grow each bar from the baseline by tweening its y/height
            // attributes — with both overshooting together, the bottom edge
            // (y + height) stays anchored. Attribute tweens also sidestep
            // GSAP's SVG transform-origin math, which displaced the rects.
            gsap.utils.toArray<SVGRectElement>('.bp-bar').forEach((bar, i) => {
              const y = Number(bar.getAttribute('y'));
              const h = Number(bar.getAttribute('height'));
              gsap.fromTo(
                bar,
                { attr: { y: y + h, height: 0 }, opacity: 0 },
                { attr: { y, height: h }, opacity: 1, duration: 0.55, ease: 'back.out(1.4)', delay: i * 0.09 },
              );
            });
            if (count) {
              const n = { v: 0 };
              count.textContent = '0';
              gsap.to(n, {
                v: 125,
                duration: 1.1,
                ease: 'power2.out',
                onUpdate: () => { count.textContent = String(Math.round(n.v)); },
              });
            }
          },
        });
      }

      // ── 125-problem grid: tiles pop in ──
      const grid = document.getElementById('bp-grid');
      if (grid) {
        ScrollTrigger.create({
          trigger: grid,
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.fromTo(
              grid.children,
              { opacity: 0, scale: 0 },
              // clearProps drops GSAP's inline transform once each tile lands,
              // so the Tailwind hover press-in can take over.
              { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(2)', stagger: { each: 0.015, from: 'random' }, clearProps: 'transform' },
            );
          },
        });
      }

      // ── Variations: the #82 tile leans left and shakes the b–k tiles out
      //    into the row beside it, then settles back to center ──
      const stage = document.getElementById('bp-var-stage');
      const base = document.getElementById('bp-var-base');
      if (stage && base) {
        ScrollTrigger.create({
          trigger: stage,
          start: 'top 75%',
          once: true,
          onEnter: () => {
            const b = base.getBoundingClientRect();
            const chips = gsap.utils.toArray<HTMLElement>('.bp-var-chip');
            const tl = gsap.timeline();
            tl.to(base, { rotation: -14, transformOrigin: '50% 100%', duration: 0.3, ease: 'power2.out' })
              // Wobble between the lean and a deeper tilt while tiles spill out.
              .to(base, { rotation: -21, duration: 0.09, yoyo: true, repeat: 11, ease: 'sine.inOut' })
              .fromTo(
                chips,
                {
                  opacity: 0,
                  scale: 0.25,
                  rotation: () => gsap.utils.random(-30, 30),
                  x: (_i: number, el: HTMLElement) => {
                    const r = el.getBoundingClientRect();
                    return b.left + b.width / 2 - (r.left + r.width / 2);
                  },
                  y: (_i: number, el: HTMLElement) => {
                    const r = el.getBoundingClientRect();
                    return b.top + b.height / 2 - (r.top + r.height / 2);
                  },
                },
                // clearProps drops the inline transform once each tile lands,
                // so the Tailwind hover press-in can take over.
                { opacity: 1, scale: 1, rotation: 0, x: 0, y: 0, duration: 0.55, ease: 'back.out(1.3)', stagger: 0.08, clearProps: 'transform' },
                '<',
              )
              .to(base, { rotation: 0, duration: 0.45, ease: 'back.out(2)', clearProps: 'transform' });
          },
        });
      }
    }
    // Reduced motion: everything is static and visible — the pre-hide CSS is
    // gated on prefers-reduced-motion, so there is nothing to undo.
  </script>
</Layout>
