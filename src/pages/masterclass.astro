<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Final states live in the markup; GSAP only hides things when it will
  // animate them, so no-JS and reduced-motion users see the complete section.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cards = gsap.utils.toArray<HTMLElement>('[data-price-card]');
    const formCard = document.querySelector<HTMLElement>('[data-form-card]');

    // The form card is the #interest-form anchor target: anchor scrolls are
    // computed from its transformed position, so a y offset here makes them
    // land 40px off (under the sticky nav). It fades in place instead.
    gsap.set(cards.filter((c) => c !== formCard), { y: 40, opacity: 0 });
    if (formCard) gsap.set(formCard, { opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: '#pricing', start: 'top 70%', once: true },
    });

    tl.to(cards, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'back.out(1.4)',
      stagger: 0.15,
      clearProps: 'transform,opacity', // restore CSS hover lift after landing
    });

    // Attention wiggle on the form card: one shake shortly after the cards
    // land, then a gentle repeat every few seconds while the page is open.
    if (formCard) {
      const wiggle = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 7 })
        .to(formCard, { rotation: -1.1, duration: 0.09, ease: 'power1.inOut' })
        .to(formCard, { rotation: 1.1, duration: 0.14, ease: 'power1.inOut' })
        .to(formCard, { rotation: -0.7, duration: 0.12, ease: 'power1.inOut' })
        .to(formCard, { rotation: 0.4, duration: 0.1, ease: 'power1.inOut' })
        .to(formCard, { rotation: 0, duration: 0.1, ease: 'power1.out' });
      tl.add(() => wiggle.play(), '+=0.5');
      document.addEventListener('lsm:form-submitted', () => {
        wiggle.pause();
        gsap.set(formCard, { rotation: 0 });
      });
    }
  }

  // The browser's own fragment scroll runs smooth (scroll-behavior on <html>)
  // and gets cancelled when content loading reflows the page mid-animation,
  // stranding hash loads partway down. Re-anchor instantly once loading settles.
  window.addEventListener('load', () => {
    const target = location.hash && document.querySelector(location.hash);
    if (target) target.scrollIntoView({ behavior: 'instant', block: 'start' });
  });
</script>

<script>
  const tabLive = document.getElementById('faq-tab-live') as HTMLElement | null;
  const tabAsync = document.getElementById('faq-tab-async') as HTMLElement | null;
  const panelLive = document.getElementById('faq-live') as HTMLElement;
  const panelAsync = document.getElementById('faq-async') as HTMLElement | null;

  if (tabLive && tabAsync && panelAsync) {
    function activateTab(tab: 'live' | 'async') {
      const isLive = tab === 'live';
      tabLive!.classList.toggle('bg-ink', isLive);
      tabLive!.classList.toggle('text-chalk', isLive);
      tabLive!.classList.toggle('bg-transparent', !isLive);
      tabLive!.classList.toggle('text-ink', !isLive);
      tabAsync!.classList.toggle('bg-ink', !isLive);
      tabAsync!.classList.toggle('text-chalk', !isLive);
      tabAsync!.classList.toggle('bg-transparent', isLive);
      tabAsync!.classList.toggle('text-ink', isLive);
      panelLive.classList.toggle('hidden', !isLive);
      panelAsync!.classList.toggle('hidden', isLive);
      // Close all open accordions in the newly shown panel
      const panel = isLive ? panelLive : panelAsync!;
      panel.querySelectorAll<HTMLElement>('.faq-body').forEach((b) => { b.style.maxHeight = '0px'; });
      panel.querySelectorAll<HTMLElement>('.faq-arrow').forEach((a) => { a.style.transform = 'rotate(0deg)'; });
    }

    tabLive.addEventListener('click', () => activateTab('live'));
    tabAsync.addEventListener('click', () => activateTab('async'));
  }

  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item') as HTMLElement;
      const body = item?.querySelector('.faq-body') as HTMLElement;
      const arrow = trigger.querySelector('.faq-arrow') as HTMLElement;
      const isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

      if (isOpen) {
        body.style.maxHeight = '0px';
        arrow.style.transform = 'rotate(0deg)';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        arrow.style.transform = 'rotate(180deg)';
      }
    });
  });

</script>

