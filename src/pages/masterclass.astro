---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import MasterclassIncluded from '../components/MasterclassIncluded.astro';

// --- ENROLLMENT CONFIG ---
// Set IS_FULL to false when a new cohort opens enrollment.
const IS_FULL = true;
const STRIPE_URL = 'https://buy.stripe.com/3cI14g4r44AH8OQb226wE12';
const WAITLIST_URL = 'https://forms.gle/5njHK2AFm8A3pTsb8';

const enrollHref = IS_FULL ? WAITLIST_URL : STRIPE_URL;
const enrollLabel = IS_FULL ? 'Join the Waitlist' : 'Enroll Now — $895';
// -------------------------

---

<Layout
  title="Masterclass"
  description="15 hours of live SAT math instruction with Eric. Small groups, office hours, recordings, and proven results. Most students finish with 750+."
>

  <!-- Hero -->
  <section class="bg-navy text-white py-14 lg:py-20">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      {IS_FULL && (
        <span class="inline-block bg-marigold text-navy text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6">
          Currently Full — Join the Waitlist
        </span>
      )}
      {!IS_FULL && (
        <span class="inline-block bg-cta text-white text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6">
          Enrollment Open
        </span>
      )}
      <h1 class="font-serif text-4xl lg:text-6xl tracking-tight mb-5">The Masterclass</h1>
      <p class="text-blue-100 text-lg lg:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
        An intensive 5-week program of <i>live</i> small-group classes, covering only the <i>hardest</i> topics, to get you to a 750 or higher.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
        <span class="font-serif text-4xl font-bold text-white">$895</span>
        <span class="text-blue-300 text-lg">total &mdash; $49 per hour</span>
      </div>
      <a
        href={enrollHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cta text-white font-semibold px-10 py-4 rounded-full hover:bg-orange-700 transition-colors text-base"
      >
        {enrollLabel}
      </a>
    </div>
  </section>

  <!-- Video -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="aspect-video w-full rounded-2xl overflow-hidden shadow-lg">
        <iframe
          src="https://www.youtube.com/embed/yNRrx2AQUwA"
          title="Masterclass overview"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-12 items-start">
        <div>
          <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-3">Everything included</p>
          <h2 class="font-serif text-3xl text-navy tracking-tight mb-6">What you get</h2>
          <MasterclassIncluded />
        </div>
        <div class="flex flex-col items-center gap-3">
          <video
            src="/masterclass_clips.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full rounded-2xl shadow-lg"
          ></video>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials (Masterclass only) -->
  <section class="py-16 lg:py-24 bg-ivory">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl text-navy tracking-tight mb-2">From Masterclass students</h2>
        <p class="text-gray-500">Hear from students who have gone through the Masterclass.</p>
      </div>
      <Testimonials filter="masterclass" />
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-navy py-16 lg:py-20 text-center">
    <div class="max-w-xl mx-auto px-6">
      <h2 class="font-serif text-3xl text-white tracking-tight mb-4">
        {IS_FULL ? 'Be first in line for the next cohort.' : 'Ready to get started?'}
      </h2>
      <p class="text-blue-200 mb-8">
        {IS_FULL
          ? 'Spots fill quickly. Join the waitlist to get notified when enrollment opens.'
          : 'Join the next cohort and join dozens of students who have reached 750+.'}
      </p>
      <a
        href={enrollHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cta text-white font-semibold px-10 py-4 rounded-full hover:bg-orange-700 transition-colors"
      >
        {enrollLabel}
      </a>
    </div>
  </section>

</Layout>
