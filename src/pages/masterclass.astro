<script>
  const tabLive = document.getElementById('faq-tab-live') as HTMLElement | null;
  const tabAsync = document.getElementById('faq-tab-async') as HTMLElement | null;
  const panelLive = document.getElementById('faq-live') as HTMLElement;
  const panelAsync = document.getElementById('faq-async') as HTMLElement | null;

  if (tabLive && tabAsync && panelAsync) {
    function activateTab(tab: 'live' | 'async') {
      const isLive = tab === 'live';
      tabLive!.classList.toggle('bg-ink', isLive);
      tabLive!.classList.toggle('text-chalk', isLive);
      tabLive!.classList.toggle('bg-transparent', !isLive);
      tabLive!.classList.toggle('text-ink', !isLive);
      tabAsync!.classList.toggle('bg-ink', !isLive);
      tabAsync!.classList.toggle('text-chalk', !isLive);
      tabAsync!.classList.toggle('bg-transparent', isLive);
      tabAsync!.classList.toggle('text-ink', isLive);
      panelLive.classList.toggle('hidden', !isLive);
      panelAsync!.classList.toggle('hidden', isLive);
      // Close all open accordions in the newly shown panel
      const panel = isLive ? panelLive : panelAsync!;
      panel.querySelectorAll<HTMLElement>('.faq-body').forEach((b) => { b.style.maxHeight = '0px'; });
      panel.querySelectorAll<HTMLElement>('.faq-arrow').forEach((a) => { a.style.transform = 'rotate(0deg)'; });
    }

    tabLive.addEventListener('click', () => activateTab('live'));
    tabAsync.addEventListener('click', () => activateTab('async'));
  }

  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item') as HTMLElement;
      const body = item?.querySelector('.faq-body') as HTMLElement;
      const arrow = trigger.querySelector('.faq-arrow') as HTMLElement;
      const isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

      if (isOpen) {
        body.style.maxHeight = '0px';
        arrow.style.transform = 'rotate(0deg)';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        arrow.style.transform = 'rotate(180deg)';
      }
    });
  });

  document.getElementById('learn-more-btn')?.addEventListener('click', (e) => {
    e.preventDefault();
    const el = document.getElementById('masterclass-video');
    if (el) {
      const rect = el.getBoundingClientRect();
      const scrollTop = window.scrollY + rect.top - (window.innerHeight / 2) + (rect.height / 2);
      window.scrollTo({ top: scrollTop, behavior: 'smooth' });
    }
  });

  document.getElementById('hero-enroll-btn')?.addEventListener('click', (e) => {
    e.preventDefault();
    const el = document.getElementById('pricing');
    if (el) {
      const rect = el.getBoundingClientRect();
      const scrollTop = window.scrollY + rect.top - (window.innerHeight / 2) + (rect.height / 2);
      window.scrollTo({ top: scrollTop, behavior: 'smooth' });
    }
  });
</script>

