---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import MasterclassSchedule from '../components/MasterclassSchedule.astro';
import MasterclassRhythm from '../components/MasterclassRhythm.astro';
import MasterclassIncluded from '../components/MasterclassIncluded.astro';
import MasterclassVsRest from '../components/MasterclassVsRest.astro';
import { MASTERCLASS_PRICE } from '../data/pricing';

// --- ENROLLMENT CONFIG ---
// Set IS_FULL to false when a new cohort opens enrollment.
const IS_FULL = true;
// Set SELF_PACED_AVAILABLE to true when the live cohort is full and self-paced should be offered.
const SELF_PACED_AVAILABLE = true;
const STRIPE_URL = 'https://buy.stripe.com/3cI8wI1eSaZ50ik2vw6wE17';
const SELF_PACED_URL = 'https://buy.stripe.com/7sY3cobTw2sz6GI3zA6wE16';
const WAITLIST_URL = 'https://forms.gle/5njHK2AFm8A3pTsb8';
const SELF_PACED_PRICE = 395;
const REFUND_DEADLINE = '4/3/26';
const CONSULTATION_URL = 'https://calendly.com/eric-wolpert-learnsatmath/masterclass-consultation';

const enrollHref = IS_FULL ? WAITLIST_URL : STRIPE_URL;
const enrollLabel = IS_FULL ? 'Join the Waitlist' : 'Enroll Now';
// -------------------------

---

<Layout
  title="Masterclass"
  description="15 hours of live SAT math instruction with Eric. Small groups, office hours, recordings, and proven results. Most students finish with 750+."
>

  <!-- Hero -->
  <section class="bg-ink-mid text-white py-14 lg:py-24 hero-section">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[11fr_9fr] gap-12 items-center">

        <!-- Left: text -->
        <div>
          {IS_FULL && (
            <span class="inline-block bg-electric text-ink border-2 border-ink text-xs font-black uppercase tracking-widest px-5 py-2 rounded-full mb-6">
              Currently Full — Join the Waitlist
            </span>
          )}
          {!IS_FULL && (
            <span class="inline-block bg-white text-ink border-2 border-ink text-sm font-black px-6 py-3 rounded-full mb-6 shadow-offset-sm">
              🟢 Enrollment OPEN · Limited spots available
            </span>
          )}
          <h1 class="font-sans font-black text-4xl lg:text-6xl tracking-tight mb-3">The Masterclass</h1>
          <p class="font-sans font-extrabold text-2xl lg:text-3xl text-chalk/80 mb-6">
            Score a 750+ in just <span class="inline-block bg-electric text-ink px-1.5 -rotate-1">5 weeks</span>
          </p>
          <p class="text-chalk/80 text-lg lg:text-xl leading-relaxed font-semibold mb-8">
            An intensive 5-week program of <em>live</em> small-group classes, covering only the <em>hardest</em> topics, to get you to a 750 or higher.
          </p>
          <div class="flex flex-wrap gap-4">
            {IS_FULL ? (
              <a
                href={WAITLIST_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base uppercase tracking-wide"
              >
                {enrollLabel}
              </a>
            ) : (
              <a
                href="#pricing"
                id="hero-enroll-btn"
                class="inline-block bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base tracking-wide"
              >
                {enrollLabel}
              </a>
            )}
            <a
              href="#masterclass-video"
              id="learn-more-btn"
              class="inline-block bg-white text-ink font-black px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base tracking-wide"
            >
              Learn More
            </a>
          </div>
        </div>

        <!-- Right: video -->
        <div>
          <video
            src="/masterclass_clips.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full rounded-2xl border-2 border-ink shadow-offset-md"
          ></video>
        </div>

      </div>
    </div>
  </section>

  <!-- Video -->
  <section id="masterclass-video" class="py-16 lg:py-20 bg-chalk">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="aspect-video w-full rounded-2xl overflow-hidden border-2 border-ink shadow-offset-md">
        <iframe
          src="https://www.youtube.com/embed/yNRrx2AQUwA"
          title="Masterclass overview"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Testimonials (Masterclass only) -->
  <section class="hidden [@media(min-width:900px)]:block py-16 lg:py-24 bg-mint">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-2">From Masterclass students</h2>
      </div>
      <Testimonials filter="masterclass" />
    </div>
  </section>

  <!-- vs. The Rest -->
  <MasterclassVsRest />

  <!-- Weekly Rhythm -->
  <MasterclassRhythm />

  <!-- Schedule -->
  <MasterclassSchedule enrollHref={enrollHref} enrollLabel={enrollLabel} />

  <!-- Pricing cards -->
  <section id="pricing" class="py-16 lg:py-24 bg-peach">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class={`grid grid-cols-1 gap-8 items-start ${SELF_PACED_AVAILABLE ? 'lg:grid-cols-2' : ''}`}>

        <!-- Self-Paced Card -->
        {SELF_PACED_AVAILABLE && (
        <div class="bg-white rounded-2xl border-2 border-ink p-8 flex flex-col shadow-offset-md relative hover:-translate-y-1 transition-transform duration-200">
          <div class="mb-6">
            <p class="text-xs font-bold uppercase tracking-widest text-ink/50 mb-2">Just the recordings</p>
            <h3 class="font-sans text-2xl text-ink font-bold mb-4">Self-Paced Masterclass</h3>
            <div class="flex items-baseline gap-2">
              <span class="font-sans text-4xl font-black text-ink">${SELF_PACED_PRICE}</span>
            </div>
          </div>
          <ul class="space-y-3 flex-1 mb-8">
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              <span>15 hours of <strong>recordings</strong> of every class from the March 2026 cohort</span>
            </li>
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              <span>Office hours with live cohorts for 1-on-1 support</span>
            </li>
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              <span><em>SAT Math from the Ground Up</em> included</span>
            </li>
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              <span>Plan &amp; resources to get you a 750+</span>
            </li>
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              <span>Discord server to collaborate with other students</span>
            </li>
            <li class="flex items-start gap-2 text-base text-ink/30">
              <span class="font-black mt-0.5">✗</span>
              <span>Access to live sessions</span>
            </li>
            <li class="flex items-start gap-2 text-base text-ink/30">
              <span class="font-black mt-0.5">✗</span>
              <span>Updated curriculum for newest cohort</span>
            </li>
          </ul>
          <p class="text-xs text-ink/50 text-center mb-3">Includes a ${SELF_PACED_PRICE} discount on any live cohort in the future.</p>
          <a
            href={SELF_PACED_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center bg-white text-ink font-bold py-3 rounded-xl border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
          >
            Enroll Now
          </a>
        </div>
        )}

        <!-- Live Masterclass Card -->
        <div class={`animated-border-wrapper rounded-2xl relative hover:-translate-y-1 transition-transform duration-200 shadow-[5px_5px_0_0_#FF5533]${!SELF_PACED_AVAILABLE ? ' max-w-md mx-auto w-full' : ''}`}>
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="bg-electric text-ink text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full border-2 border-ink whitespace-nowrap">
              Best Results
            </span>
          </div>
          <div class="bg-ink-mid rounded-[14px] p-8 flex flex-col">
            <div class="mb-6 mt-4">
              <p class="text-xs font-bold uppercase tracking-widest text-chalk/60 mb-2">Live small group classes</p>
              <h3 class="font-sans text-2xl text-chalk font-bold mb-4">Masterclass</h3>
              <div class="flex items-baseline gap-2">
                <span class="font-sans text-4xl font-black text-chalk">${MASTERCLASS_PRICE}</span>
                <span class="text-chalk/60 text-sm">$49 per hour</span>
              </div>
            </div>
            <div class="flex-1 mb-8">
              <MasterclassIncluded dark={true} />
            </div>
            <!-- <p class="text-xs text-chalk/40 text-center mb-3">Purchase is fully refundable through {REFUND_DEADLINE}.</p> -->
            <a
              href={enrollHref}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-center bg-coral text-white font-bold py-3 rounded-xl border-2 border-chalk shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
            >
              {enrollLabel}
            </a>
          </div>
        </div>

      </div>
      <p class="text-center text-base text-ink/50 mt-8">
        Not sure yet? <a href={CONSULTATION_URL} target="_blank" rel="noopener noreferrer" class="underline hover:text-ink transition-colors">Book a free consultation call</a> or <a href="mailto:eric.wolpert@learnsatmath.com" class="underline hover:text-ink transition-colors">reach out by email</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 lg:py-24 bg-chalk">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-2">Frequently Asked Questions</h2>
        <p class="text-ink/60 font-semibold">Everything you need to know before enrolling.</p>
      </div>

      <!-- Tab toggle -->
      {SELF_PACED_AVAILABLE && (
      <div class="flex justify-center mb-10">
        <div class="inline-flex border-2 border-ink rounded-full p-1 bg-white shadow-offset-sm">
          <button
            id="faq-tab-async"
            class="px-6 py-2 rounded-full font-sans font-bold text-sm uppercase tracking-wide transition-colors duration-200 bg-transparent text-ink"
          >
            Self-Paced
          </button>
          <button
            id="faq-tab-live"
            class="px-6 py-2 rounded-full font-sans font-bold text-sm uppercase tracking-wide transition-colors duration-200 bg-ink text-chalk"
          >
            Live Masterclass
          </button>
        </div>
      </div>
      )}

      <!-- Live FAQ -->
      <div id="faq-live" class="space-y-3">

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What score do I need to enter the class?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <p class="px-6 pb-6 text-ink/80 font-semibold leading-relaxed">The Masterclass is designed for students currently scoring between a 630 and 750, who are aiming for a 750-800. If you're below a 630, you can still join, but you'll need to work extra hard to keep up.</p>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What if I need to miss a session?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <p class="px-6 pb-6 text-ink/80 font-semibold leading-relaxed">No worries! Every session will be recorded, so you'll never get behind. If you have questions from the recording, shoot me an email.</p>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">How small is the class?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>The Masterclass has a hard cap of 15 students. It's much lower than most test prep, because I want the class to feel like a discussion, not a lecture.</p>
              <p>Also, since the sessions are recorded, expect a lot of absences. Typically each session is only 50-75% full, so don't worry, it's far more interactive than your typical high school class.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What is the time commitment between classes?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>While all Masterclass students are aiming for top scores, some students want to push harder than others. So, I've developed two distinct plans:</p>
              <p>The <strong>Standard Plan</strong> is around 4-5 hours a week outside of classes, for students aiming for a 700-760 / generally an 80-100 point improvement.</p>
              <p>The <strong>Advanced Plan</strong> is around 6-10+ hours a week outside of classes, for students who are gunning for a perfect score. The main difference aside from volume is that the Standard Plan uses OnePrep for practice problems and the Advanced Plan uses the PrepPros book.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">Do I need to buy myself any additional resources?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>Not with the Standard Plan! (see the question above for clarification on what the standard plan is)</p>
              <p>With the Advanced Plan, I highly recommend students buy the PrepPros Complete Guide to Digital SAT Math and the answer explanation videos, which total to around $50.</p>
              <p>OnePrep and PrepPros are both great resources for practice problems. However, PrepPros has a greater share of niche challenging problems. If you're going for an 800, these are essential! But for a 700-750, these niche problems can end up a distraction from the core material. That's why I no longer buy every student the PrepPros book (like I did in the fall).</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">How do office hours work?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <p class="px-6 pb-6 text-ink/80 font-semibold leading-relaxed">Office hours are a chance for students to get personalized help with any topics/problems they're struggling with, live in a Google Meet call with other students. Sometimes, students don't have any particular questions, but still tune in to the call in case anything interesting comes up!</p>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What if a session gets cancelled?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <p class="px-6 pb-6 text-ink/80 font-semibold leading-relaxed">Schedules aren't always predictable this far in advance! If I ever need to cancel a session due to sickness or major events, we'll reschedule to Tuesday 7:00 - 8:30 pm ET the following week.</p>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">Do you guarantee a 750+?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>I do not offer score guarantees. Almost every test prep platform with score guarantees has caveats in the fineprint (i.e. "must complete all 500 hours of material").</p>
              <p>Instead, I let the results of my students speak for themselves. Nearly every Masterclass student who has put the requisite time and effort to get a 750 has achieved it. I don't want a score guarantee to relieve students of accountability or disincentivize perseverance.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">Can I get a refund if I change my mind?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>Within 7 days from the first session, you're able to request a full refund of the masterclass, no questions asked. If you get a refund, you'll lose access to the class's recordings and resources.</p>
              <p>So far, however, I have not had a single one of the 80+ masterclass students request a refund. Hope to keep it that way!</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Async FAQ -->
      {SELF_PACED_AVAILABLE && (
      <div id="faq-async" class="space-y-3 hidden">

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What score do I need to enter the class?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
