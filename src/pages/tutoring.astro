<script>
  function scrollToPricingCenter(smooth = true) {
    const pricing = document.getElementById('pricing');
    if (pricing) {
      const top = pricing.getBoundingClientRect().top + window.scrollY;
      const center = top + pricing.offsetHeight / 2 - window.innerHeight / 2;
      window.scrollTo({ top: center, behavior: smooth ? 'smooth' : 'instant' });
    }
  }

  document.querySelector('a[href="#pricing"]')?.addEventListener('click', (e) => {
    e.preventDefault();
    scrollToPricingCenter();
  });

  // Open Calendly links in a popup overlay instead of a new tab.
  // Falls back to the plain link (target="_blank") if the widget script hasn't loaded.
  const prefetched = new Set<string>();

  // Warm the actual scheduling page the moment the user shows intent (hover / touch),
  // so the popup has a head start before they click. Fires once per URL.
  const prefetchCalendly = (url: string) => {
    if (prefetched.has(url)) return;
    prefetched.add(url);
    const link = document.createElement('link');
    link.rel = 'prefetch';
    link.href = url;
    link.as = 'document';
    document.head.appendChild(link);
  };

  document.querySelectorAll<HTMLAnchorElement>('a[data-calendly]').forEach((link) => {
    link.addEventListener('pointerenter', () => prefetchCalendly(link.href));
    link.addEventListener('touchstart', () => prefetchCalendly(link.href), { passive: true });

    link.addEventListener('click', (e) => {
      const Calendly = (window as any).Calendly;
      if (Calendly) {
        e.preventDefault();
        Calendly.initPopupWidget({ url: link.href });
      }
    });
  });

  if (window.location.hash === '#pricing') {
    scrollToPricingCenter(false);
  }

  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item') as HTMLElement;
      const body = item?.querySelector('.faq-body') as HTMLElement;
      const arrow = trigger.querySelector('.faq-arrow') as HTMLElement;
      const isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

      if (isOpen) {
        body.style.maxHeight = '0px';
        arrow.style.transform = 'rotate(0deg)';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        arrow.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Final states live in the markup; GSAP only hides things when it will
  // animate them, so no-JS and reduced-motion users see the complete section.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cards = gsap.utils.toArray<HTMLElement>('[data-price-card]');
    const slashPrices = gsap.utils.toArray<HTMLElement>('[data-slash-price]');
    const slashes = gsap.utils.toArray<HTMLElement>('[data-slash]');

    gsap.set(cards, { y: 40, opacity: 0 });
    gsap.set(slashPrices, { opacity: 0 });
    gsap.set(slashes, { scaleX: 0, transformOrigin: 'left center' });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: '#pricing', start: 'top 70%', once: true },
    });

    // Side cards land first, the featured middle card last
    const ordered = [cards[0], cards[2], cards[1]].filter(Boolean);
    tl.to(ordered, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'back.out(1.4)',
      stagger: 0.15,
      clearProps: 'transform,opacity', // restore CSS hover lift after landing
    });

    tl.to(slashPrices, { opacity: 1, duration: 0.3 }, '>');
    tl.to(slashes, { scaleX: 1, duration: 0.3, ease: 'power2.inOut', stagger: 0.1 }, '<');

    // "This week's plan": rows slide in one by one with their checkmarks
    // popping in, then the projected score counts up as its bar fills.
    const planRows = gsap.utils.toArray<HTMLElement>('.plan-row');
    const planChecks = gsap.utils.toArray<HTMLElement>('.plan-check');
    const scoreBar = document.getElementById('plan-score-bar');
    const scoreChip = document.getElementById('plan-score-chip');
    const scoreValue = document.getElementById('plan-score-value');

    gsap.set(planRows, { y: 24, opacity: 0 });
    gsap.set(planChecks, { scale: 0 });
    if (scoreBar) gsap.set(scoreBar, { width: 0 });
    if (scoreChip) gsap.set(scoreChip, { scale: 0 });

    const planTl = gsap.timeline({
      scrollTrigger: { trigger: '#plan-card', start: 'top 75%', once: true },
    });
    planTl.to(planRows, { y: 0, opacity: 1, duration: 0.5, ease: 'back.out(1.4)', stagger: 0.22 });
    planTl.to(planChecks, { scale: 1, duration: 0.4, ease: 'back.out(2.5)', stagger: 0.22 }, '<0.2');

    if (scoreBar && scoreValue) {
      const from = Number(scoreValue.dataset.from);
      const to = Number(scoreValue.dataset.to);
      const counter = { v: from };
      planTl.to(scoreBar, { width: scoreBar.dataset.width, duration: 0.9, ease: 'power2.inOut' }, '>-0.1');
      planTl.to(counter, {
        v: to,
        duration: 0.9,
        ease: 'power2.inOut',
        onStart: () => { scoreValue.textContent = String(from); },
        onUpdate: () => { scoreValue.textContent = String(Math.round(counter.v)); },
      }, '<');
    }
    if (scoreChip) {
      planTl.to(scoreChip, { scale: 1, duration: 0.4, ease: 'back.out(2.5)' }, '>-0.2');
    }
  }
</script>

