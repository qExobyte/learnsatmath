---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';

const CALENDLY_URL = 'https://calendly.com/eric-wolpert-learnsatmath/1-on-1-sat-math-tutoring';

const features = [
  { icon: '📅', title: 'Flexible scheduling', body: 'Book on-demand whenever you need a session. No rigid weekly commitment.' },
  { icon: '🎯', title: 'Fully personalized', body: 'Every session is built around your weaknesses. No generic curriculum.' },
  { icon: '🧮', title: 'Desmos mastery', body: 'Learn to use the Desmos calculator as much as possible.' },
  { icon: '📖', title: 'Book included', body: 'Every student gets a free copy of SAT Math from the Ground Up to reinforce sessions.' },
  { icon: '🗺️', title: 'Structured plan', body: 'We close every session with a clear roadmap of what to tackle before we meet again.' },
];
---

<Layout
  title="1-on-1 Tutoring"
  description="Private SAT math tutoring with Eric. Personalized instruction, flexible scheduling, and proven results. Book a session directly."
>

  <!-- Hero -->
  <section class="bg-ink-mid text-white py-14 lg:py-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[11fr_9fr] gap-12 items-center">

        <!-- Left: text -->
        <div>
          <h1 class="font-sans font-black text-5xl lg:text-7xl tracking-tight mb-3">1-on-1 Tutoring</h1>
          <p class="font-sans font-extrabold text-2xl lg:text-3xl text-chalk/80 mb-6">
            Focused entirely on <span class="inline-block bg-electric text-ink px-1.5 -rotate-1">you</span>
          </p>
          <p class="text-chalk/80 text-lg lg:text-xl leading-relaxed font-semibold mb-6">
            Personalized instruction around your weaknesses, your pace, and your goals — one session at a time.
          </p>
          <a
            href="#book"
            class="book-btn inline-block bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base uppercase tracking-wide"
          >
            Book a Session
          </a>
        </div>

        <!-- Right: video -->
        <div>
          <video
            src="/tutoring_sizzle.mp4"
            autoplay
            loop
            muted
            playsinline
            class="w-full rounded-2xl border-2 border-ink shadow-offset-md"
          ></video>
        </div>

      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-16 lg:py-24 bg-peach">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">

        <h2 class="font-sans text-3xl lg:text-5xl font-extrabold text-ink tracking-tight">What you get</h2>
      </div>
      <div class="flex flex-col items-center gap-5">
        <div class="flex flex-wrap justify-center gap-5">
          {features.slice(0, 2).map(({ icon, title, body }) => (
            <div class="w-full sm:w-80 bg-white rounded-2xl border-2 border-ink shadow-offset-sm p-6 flex flex-col gap-3 hover:-translate-y-1 transition-transform duration-200">
              <span class="text-3xl">{icon}</span>
              <h3 class="font-sans font-bold text-lg text-ink">{title}</h3>
              <p class="text-ink/70 font-semibold leading-relaxed text-sm">{body}</p>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap justify-center gap-5">
          {features.slice(2).map(({ icon, title, body }) => (
            <div class="w-full sm:w-72 bg-white rounded-2xl border-2 border-ink shadow-offset-sm p-6 flex flex-col gap-3 hover:-translate-y-1 transition-transform duration-200">
              <span class="text-3xl">{icon}</span>
              <h3 class="font-sans font-bold text-lg text-ink">{title}</h3>
              <p class="text-ink/70 font-semibold leading-relaxed text-sm">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 lg:py-24 bg-sky">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-sans text-3xl lg:text-5xl font-extrabold text-ink tracking-tight mb-2">From tutoring students</h2>
      </div>
      <Testimonials filter="other" />
    </div>
  </section>

  <!-- Calendly booking -->
  <section id="book" class="py-16 lg:py-24 bg-chalk">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">

        <h2 class="font-sans text-3xl lg:text-5xl font-extrabold text-ink tracking-tight mb-2">Book a session</h2>
        <p class="text-ink/60 font-semibold">Only book what you need! No massive packages.</p>
      </div>
      <div
        class="calendly-inline-widget"
        data-url={CALENDLY_URL}
        style="min-width:320px;height:700px;width:100%;"
      ></div>
      <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-24 bg-mint">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-10">

        <h2 class="font-sans text-3xl lg:text-5xl font-extrabold text-ink tracking-tight">Common questions</h2>
      </div>
      <div class="space-y-3" id="faq-list">

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">Should I get 1-on-1 tutoring or join the Masterclass?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>If you're scoring under a 630, start with 1-on-1 sessions. You should always prioritize the easiest problems you're missing, and the Masterclass focuses on SAT math's hardest problems.</p>
              <p>If you're above a 630, I'd recommend the Masterclass — with 1-on-1 sessions as a supplement if needed. Think of the Masterclass as teaching you the content of the test, and 1-on-1 sessions as "office hours" for topics you just can't wrap your head around. Plus, group classes cost much less!</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What makes your tutoring better than test prep companies?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>A simple Google search for "Princeton Review tutor salaries" shows they pay tutors $20–$40/hr while charging $250/hr+. You're paying for the brand, not the tutor.</p>
              <p>Their bundles (up to $10,000!) prioritize quantity over quality — hundreds of unengaging videos and thousands of problems, many AI-generated. But students only have so much time.</p>
              <p>My tutoring is focused on efficiency and outcomes. At any point in our prep, we focus entirely on the topic that yields the highest return in the lowest amount of time.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What materials should I use?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p><strong>Getting a representative score</strong> → Bluebook.</p>
              <p><strong>Learning &amp; reinforcing concepts</strong> → SAT Math from the Ground Up.</p>
              <p><strong>Practice problems</strong> → OnePrep or PrepPros.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">How much will my score improve with tutoring?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>There's no golden ticket where you can pay a certain amount for a certain SAT score. Almost every test prep company with score guarantees has caveats in the fineprint.</p>
              <p>Instead, I let the results of my students speak for themselves. Most Masterclass students score over 750, and many of my 1-on-1 students improve 150+ points or surpass their personal goals.</p>
              <p>But this progress takes time and effort. I don't want a score guarantee to relieve students of accountability or disincentivize perseverance.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">Do you assign homework? How much?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <div class="px-6 pb-6 space-y-3 text-ink/80 font-semibold leading-relaxed">
              <p>Sessions are fully personalized, so there's no rigid curriculum. Instead, I meet each student where they are and we close every session with a clear sense of which areas to prioritize before we meet again.</p>
              <p>I recommend spending at least 2 hours on practice problems between sessions. This keeps our time together focused entirely on your weaknesses and questions — where the real gains happen.</p>
            </div>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">What if I need to cancel a session?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <p class="px-6 pb-6 text-ink/80 font-semibold leading-relaxed">Sessions are fully refundable as long as you cancel at least 6 hours before the scheduled start time. This can be done automatically through Calendly or by sending an email. Otherwise, the full session price is charged.</p>
          </div>
        </div>

        <div class="faq-item border-2 border-ink rounded-2xl bg-white shadow-offset-sm overflow-hidden">
          <button class="faq-trigger w-full flex items-center justify-between px-6 py-5 text-left gap-4">
            <span class="font-sans font-bold text-lg text-ink">Do you tutor other subjects too?</span>
            <svg class="faq-arrow flex-shrink-0 w-5 h-5 text-ink transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="faq-body max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out">
            <p class="px-6 pb-6 text-ink/80 font-semibold leading-relaxed">Nope! I've specialized so that I can become the best SAT math tutor online.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 lg:py-20 bg-ink-mid text-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="font-sans font-black text-3xl lg:text-5xl tracking-tight mb-4">Ready to start?</h2>
      <p class="text-chalk/70 font-semibold text-lg mb-8">Pick a time that works and let's get to work on your score.</p>
      <a
        href="#book"
        class="book-btn inline-block bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base uppercase tracking-wide"
      >
        Book a Session
      </a>
    </div>
  </section>

</Layout>

<script>
  document.querySelectorAll('.book-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const el = document.getElementById('book');
      if (el) {
        const rect = el.getBoundingClientRect();
        const scrollTop = window.scrollY + rect.top - (window.innerHeight / 2) + (rect.height / 2);
        window.scrollTo({ top: scrollTop, behavior: 'smooth' });
      }
    });
  });

  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item') as HTMLElement;
      const body = item?.querySelector('.faq-body') as HTMLElement;
      const arrow = trigger.querySelector('.faq-arrow') as HTMLElement;
      const isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

      if (isOpen) {
        body.style.maxHeight = '0px';
        arrow.style.transform = 'rotate(0deg)';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        arrow.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
