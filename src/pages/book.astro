---
import Layout from '../layouts/Layout.astro';

const chapters = [
  {
    num: 1,
    title: 'Algebra & Functions',
    topics: 'Algebra · Terms · Functions · Linear Functions · Systems of Equations & Inequalities · Regressions',
  },
  {
    num: 2,
    title: 'Exponential Growth',
    topics: 'Percentages · Exponent Rules · Exponential Functions',
  },
  {
    num: 3,
    title: 'Quadratics',
    topics: 'Quadratic Equations · Quadratic Functions · Polynomial Functions',
  },
  {
    num: 4,
    title: 'Geometry & Trig',
    topics: 'Angles · Triangles · Circles · Area, Surface Area & Volume',
  },
  {
    num: 5,
    title: 'Statistics',
    topics: 'Scatterplots · Probability · Mean, Median & Standard Deviation · Frequency Tables · Box Plots · Sampling',
  },
  {
    num: 6,
    title: 'Overview of Every Topic',
    topics: '',
  },
  {
    num: 7,
    title: '25 Challenging Problems',
    topics: '',
  },
];

const included = [
  '110-page comprehensive ebook',
  '240+ conceptual questions with explanations',
  '25 challenging SAT-style problems',
  'Desmos tricks and procedures',
  'Complete formula list',
];

const gumroadUrl = 'https://learnsatmath.gumroad.com/l/groundup?wanted=true';
---

<Layout title="Book" description="SAT Math from the Ground Up — the definitive 110-page SAT math ebook by Eric Wolpert. Master every topic from scratch.">

  <!-- Hero -->
  <section class="bg-navy text-white py-20 lg:py-28">
    <div class="max-w-2xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-4">The Definitive SAT Math Ebook</p>
      <h1 class="font-serif text-4xl lg:text-5xl tracking-tight mb-4 leading-tight">SAT Math from the Ground Up</h1>
      <p class="text-blue-200 text-lg mb-8">A book focused on understanding, rather than memorization.</p>
      <div class="flex items-baseline justify-center gap-3 mb-8">
        <span class="font-serif text-5xl font-bold">$49</span>
        <span class="text-blue-300">one-time · instant PDF download</span>
      </div>
      <a
        href={gumroadUrl}
        data-gumroad-overlay-checkout="true"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cta text-white font-semibold px-10 py-4 rounded-full hover:bg-orange-700 transition-colors text-lg"
      >
        Buy Now — $49
      </a>
    </div>
  </section>

  <!-- YouTube embed -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="aspect-video w-full rounded-2xl overflow-hidden shadow-lg">
        <iframe
          src="https://www.youtube.com/embed/IBzCEHgDUf0"
          title="SAT Math from the Ground Up — overview"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Selling point 1: Formulas are not enough -->
  <section class="py-16 lg:py-24 bg-ivory">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-3">The problem</p>
          <h2 class="font-serif text-3xl text-navy tracking-tight mb-4">Formulas are not enough</h2>
          <p class="text-gray-600 text-lg leading-relaxed">
            The SAT is becoming more and more <b>conceptual,</b> rewarding <b>understanding</b> over memorization.
          </p>
          <br>
          <p class="text-gray-600 text-lg leading-relaxed">
            However, most test prep is stuck in the past, teaching you <b>how</b> to solve problems but not <b>why</b> those processes work.
          </p>
          <br>
          <p class="text-gray-600 text-lg leading-relaxed">
            SAT Math from the Ground Up focuses on teaching a <b>deep</b> understanding of the math behind the SAT with 240+ open-ended conceptual questions.
          </p>
        </div>
        <div>
          <img
            src="/ground3.PNG"
            alt="Deep conceptual explanation from the book"
            class="w-full rounded-2xl shadow-lg border border-gray-100"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Selling point 2: A year of lessons for just $49 -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <img
            src="/surfacearea.png"
            alt="Worked example from the book"
            class="w-full rounded-2xl shadow-lg border border-gray-100"
          />
        </div>
        <div class="order-1 lg:order-2">
          <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-3">The value</p>
          <h2 class="font-serif text-3xl text-navy tracking-tight mb-4">A year of lessons for just $49</h2>
          <p class="text-gray-600 text-lg leading-relaxed">
            Many questions target <b>specific mistakes</b> that I see students make over and over again. I've spent over a year compiling the best lessons from my $285/hr tutoring. 
          </p>
          <br>
          <p class="text-gray-600 text-lg leading-relaxed">
            Since desmos is critical for the digital SAT, the book also covers <b>why</b> certain desmos tricks, like regressions, work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selling point 3: Built to get you an 800 -->
  <section class="py-16 lg:py-24 bg-ivory">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-3">The goal</p>
          <h2 class="font-serif text-3xl text-navy tracking-tight mb-4">Built to get you an 800</h2>
          <p class="text-gray-600 text-lg leading-relaxed">
            All content in the book is divided by difficulty, so students can built their understanding level-by-level.
          </p>
          <br>
          <p class="text-gray-600 text-lg leading-relaxed">
            If you can solve the <b>25 challenging problems</b> at the end of the book, you're in good shape for a 750-800.
          </p>
        </div>
        <div>
          <img
            src="/hardproblem.png"
            alt="Hard problem from the book"
            class="w-full rounded-2xl shadow-lg border border-gray-100"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-2xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-3">Everything included</p>
      <h2 class="font-serif text-3xl text-navy tracking-tight mb-10">What you get</h2>
      <ul class="space-y-3 text-left mx-auto w-fit">
        {included.map(f => (
          <li class="flex items-start gap-3 text-base text-gray-700">
            <span class="text-marigold font-bold mt-0.5">✓</span>
            {f}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Table of contents -->
  <section class="py-16 lg:py-24 bg-ivory">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-marigold text-xs font-semibold uppercase tracking-widest mb-3">Inside the book</p>
        <h2 class="font-serif text-3xl text-navy tracking-tight">Table of contents</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {chapters.map(ch => (
          <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-1">Chapter {ch.num}</p>
            <p class="font-serif text-lg text-navy font-bold leading-snug">{ch.title}</p>
            {ch.topics && (
              <p class="text-sm text-gray-400 mt-2 leading-relaxed">{ch.topics}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 lg:py-28 bg-navy text-white text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-serif text-3xl lg:text-4xl tracking-tight mb-4">Ready to master SAT math?</h2>
      <p class="text-blue-200 text-lg mb-8">110 pages. Every topic. One payment.</p>
      <a
        href={gumroadUrl}
        data-gumroad-overlay-checkout="true"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cta text-white font-semibold px-10 py-4 rounded-full hover:bg-orange-700 transition-colors text-lg"
      >
        Buy Now — $49
      </a>
    </div>
  </section>

  <script src="https://gumroad.com/js/gumroad.js"></script>
</Layout>
