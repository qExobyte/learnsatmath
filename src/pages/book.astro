---
import Layout from '../layouts/Layout.astro';
import Highlight from '../components/Highlight.astro';
import { TUTORING_HOURLY_PRICE } from '../data/pricing';

const chapters = [
  {
    num: 1,
    title: 'Algebra & Functions',
    topics: 'Algebra · Terms · Functions · Linear Functions · Systems of Equations & Inequalities · Regressions',
  },
  {
    num: 2,
    title: 'Exponential Growth',
    topics: 'Percentages · Exponent Rules · Exponential Functions',
  },
  {
    num: 3,
    title: 'Quadratics',
    topics: 'Factoring · Quadratic Equations · Quadratic Functions · Polynomial Functions · Rational Functions',
  },
  {
    num: 4,
    title: 'Geometry & Trig',
    topics: 'Angles · Triangles · Circles · Area, Surface Area & Volume',
  },
  {
    num: 5,
    title: 'Statistics',
    topics: 'Scatterplots · Probability · Mean, Median & Standard Deviation · Frequency Tables · Box Plots · Sampling',
  },
  {
    num: 6,
    title: 'Overview of Every Topic',
    topics: 'Know exactly what to know.',
  },
  {
    num: 7,
    title: '25 Challenging Problems',
    topics: 'If you can solve these, you can get a 750+.',
  },
];

const included = [
  '110-page comprehensive ebook',
  '240+ conceptual questions with explanations',
  '25 challenging SAT-style problems',
  'Desmos tricks and procedures',
  'Complete formula list',
];

const gumroadUrl = 'https://learnsatmath.gumroad.com/l/groundup?wanted=true';
---

<Layout title="Book" description="SAT Math from the Ground Up — the definitive 110-page SAT math ebook by Eric Wolpert. Master every topic from scratch.">

  <!-- Hero -->
  <section class="bg-ink-mid text-chalk py-12 lg:py-16 hero-section">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="font-sans text-4xl lg:text-6xl font-black tracking-tight mb-4 leading-tight">SAT Math from the Ground Up</h1>
      <p class="font-sans font-extrabold text-2xl lg:text-3xl text-chalk/80 mb-6">
        Learn the <Highlight>concepts</Highlight> behind the test
      </p>
      <a
        href="#pricing"
        class="inline-block bg-coral text-chalk font-bold px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-lg"
      >
        BUY NOW
      </a>
    </div>
  </section>

  <!-- YouTube embed -->
  <section class="py-12 lg:py-14 bg-chalk">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="aspect-video w-full rounded-2xl overflow-hidden border-2 border-ink shadow-offset-md">
        <iframe
          src="https://www.youtube.com/embed/IBzCEHgDUf0"
          title="SAT Math from the Ground Up — overview"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Selling point 1: Formulas are not enough -->
  <section class="py-12 lg:py-16 bg-sky">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 2xl:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="font-sans font-extrabold text-2xl text-ink mb-4"><span class="inline-block bg-electric text-ink px-1.5 -rotate-1">The Problem</span></p>
          <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-4">Formulas are not enough</h2>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            The SAT is becoming more and more <b>conceptual,</b> rewarding <b>understanding</b> over memorization.
          </p>
          <br>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            However, most test prep is stuck in the past, teaching you <b>how</b> to solve problems but not <b>why</b> those processes work.
          </p>
          <br>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            SAT Math from the Ground Up focuses on teaching a <b>deep</b> understanding of the math behind the SAT with 240+ open-ended conceptual questions.
          </p>
        </div>
        <div>
          <img
            src="/ground3.PNG"
            alt="Deep conceptual explanation from the book"
            class="w-full rounded-2xl border-2 border-ink shadow-offset-md"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Selling point 2: A year of lessons for just $49 -->
  <section class="py-12 lg:py-16 bg-mint">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 2xl:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <img
            src="/surfacearea.png"
            alt="Worked example from the book"
            class="w-full rounded-2xl border-2 border-ink shadow-offset-md"
          />
        </div>
        <div class="order-1 lg:order-2">
          <p class="font-sans font-extrabold text-2xl text-ink mb-4"><span class="inline-block bg-electric text-ink px-1.5 -rotate-1">The Value</span></p>
          <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-4">A year of lessons for just $49</h2>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            Many questions target <b>specific mistakes</b> that I see students make over and over again. I've spent over a year compiling the best lessons from my ${TUTORING_HOURLY_PRICE}/hr tutoring.
          </p>
          <br>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            Since desmos is critical for the digital SAT, the book also covers <b>why</b> certain desmos tricks, like regressions, work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selling point 3: Built to get you an 800 -->
  <section class="py-12 lg:py-16 bg-peach">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 2xl:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="font-sans font-extrabold text-2xl text-ink mb-4"><span class="inline-block bg-electric text-ink px-1.5 -rotate-1">The Goal</span></p>
          <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-4">Built to get you an 800</h2>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            All content in the book is divided by difficulty, so students can build their understanding level-by-level.
          </p>
          <br>
          <p class="text-ink/80 font-semibold text-lg leading-relaxed">
            If you can solve the <b>25 challenging problems</b> at the end of the book, you're in good shape for a 750-800.
          </p>
        </div>
        <div>
          <img
            src="/hardproblem.png"
            alt="Hard problem from the book"
            class="w-full rounded-2xl border-2 border-ink shadow-offset-md"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section id="pricing" class="py-12 lg:py-16 bg-chalk scroll-mt-20">
    <div class="max-w-md mx-auto px-6 lg:px-8">
      <div class="bg-white rounded-2xl border-2 border-ink shadow-offset-md p-8 flex flex-col">
        <p class="text-xs font-bold uppercase tracking-widest text-ink/50 mb-2">Instant PDF download</p>
        <h2 class="font-sans text-2xl font-extrabold text-ink tracking-tight mb-3">SAT Math from the Ground Up</h2>
        <div class="flex items-baseline gap-2 mb-6">
          <span class="font-sans text-4xl font-black text-ink">$49</span>
          <span class="text-ink/50 font-semibold text-sm">one-time</span>
        </div>
        <ul class="space-y-3 flex-1 mb-8">
          {included.map(f => (
            <li class="flex items-start gap-3 text-base text-ink font-semibold">
              <span class="text-coral font-black mt-0.5">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={gumroadUrl}
          data-gumroad-overlay-checkout="true"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center bg-coral text-chalk font-bold px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-lg"
        >
          Buy Now
        </a>
      </div>

      <!-- Social proof -->
      <article class="mt-6 bg-white rounded-2xl border-2 border-ink shadow-offset-sm p-7 flex flex-col gap-4">
        <header class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <p class="font-bold text-ink">Timber Puzzles</p>
            <p class="text-ink/50 text-sm mt-0.5">Verified Gumroad review</p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="bg-red-100 text-red-700 border border-red-300 text-sm font-black px-3 py-1 rounded-full">640</span>
            <span class="text-ink/50 text-sm">→</span>
            <span class="bg-green-100 text-green-700 border border-green-300 text-sm font-black px-3 py-1 rounded-full">750</span>
          </div>
        </header>
        <blockquote class="font-serif italic text-ink leading-relaxed text-base">
          &ldquo;This book is awesome! I scored a 640 on Bluebook practice test 6 before using your
          resources. After doing every problem in the book, I scored a 750 on the June SAT. Would
          recommend to anybody wanting to get a 750+ on the math section.&rdquo;
        </blockquote>
      </article>
    </div>
  </section>

  <!-- Table of contents -->
  <section class="py-12 lg:py-16 bg-lavender">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 2xl:px-12">
      <div class="text-center mb-12">
        <span class="inline-block bg-electric text-ink border-2 border-ink font-black uppercase tracking-widest rounded-full px-4 py-1.5 text-xs mb-4">Inside the Book</span>
        <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight">Table of contents</h2>
      </div>
      <div class="max-w-xl mx-auto relative pl-6 border-l-2 border-ink flex flex-col gap-4">
        {chapters.map(ch => (
          <div class="bg-white border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm transition-transform duration-200 hover:-translate-y-0.5">
            <p class="text-xs font-black uppercase tracking-widest text-ink/40 mb-1">Ch. {ch.num}</p>
            <p class="font-sans text-lg text-ink font-bold leading-snug">{ch.title}</p>
            {ch.topics && (
              <p class="text-sm text-ink/60 font-semibold mt-1 leading-relaxed">{ch.topics}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-14 lg:py-20 bg-ink-mid text-chalk text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="font-sans text-2xl lg:text-4xl font-extrabold tracking-tight mb-8">Ready to master SAT math?</h2>
      <a
        href={gumroadUrl}
        data-gumroad-overlay-checkout="true"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-coral text-chalk font-bold px-10 py-4 rounded-full border-2 border-ink shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-lg"
      >
        Buy Now
      </a>
    </div>
  </section>

  <script src="https://gumroad.com/js/gumroad.js"></script>
</Layout>

<style>
  .hero-section {
    padding-top: clamp(1.5rem, 8vh, 6rem);
    padding-bottom: clamp(1.5rem, 8vh, 6rem);
  }
</style>
