---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatBar from '../components/StatBar.astro';
import Products from '../components/Products.astro';
import Testimonials from '../components/Testimonials.astro';
import About from '../components/About.astro';
---

<Layout title="Home">
  <Hero />
  <StatBar />
  <Products />

  <!-- Testimonials -->
  <section class="hidden [@media(min-width:900px)]:block py-20 lg:py-28 bg-sky reveal">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-sans text-3xl lg:text-5xl font-extrabold text-ink tracking-tight mb-3">Real students. Real scores.</h2>
      </div>
      <Testimonials filter="all" />
    </div>
  </section>

  <About />
</Layout>
