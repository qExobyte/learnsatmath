---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatBar from '../components/StatBar.astro';
import Products from '../components/Products.astro';
import Testimonials from '../components/Testimonials.astro';
import About from '../components/About.astro';
---

<Layout title="Home">
  <Hero />
  <StatBar />
  <Products />

  <!-- Testimonials -->
  <section class="py-20 lg:py-28 bg-ivory">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-serif text-3xl lg:text-4xl text-navy tracking-tight mb-3">Real students. Real scores.</h2>
        <p class="text-gray-500 max-w-lg mx-auto">
          Hear from students who have gone through the Masterclass and 1-on-1 sessions.
        </p>
      </div>
      <Testimonials filter="all" />
    </div>
  </section>

  <About />
</Layout>
