---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'Premium SAT Math instruction from a two-time perfect scorer. 400+ students across the SAT Math Masterclass and 1-on-1 sessions.', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon-imprecise.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
    <title>{title} | LearnSATMath</title>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EKENVY91TK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EKENVY91TK');
    </script>
    <style>
      html { font-size: 18px; }
    </style>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      /* Hidden state only when JS will run and motion is allowed; GSAP animates to visible. */
      @media (prefers-reduced-motion: no-preference) {
        html.js .reveal {
          opacity: 0;
          transform: translateY(24px);
        }
      }
    </style>
  </head>
  <body class="bg-chalk font-sans text-ink antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { gsap, ScrollTrigger, prefersReducedMotion } from '../scripts/motion';

      if (!prefersReducedMotion()) {
        ScrollTrigger.batch(gsap.utils.toArray<HTMLElement>('.reveal'), {
          start: 'top 90%',
          once: true,
          onEnter: (batch) =>
            gsap.to(batch, {
              opacity: 1,
              y: 0,
              duration: 0.6,
              ease: 'power3.out',
              stagger: 0.1,
            }),
        });
      }
    </script>
  </body>
</html>
