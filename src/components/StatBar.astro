---
import { testimonials } from '../data/testimonials';

// Only testimonials that show a full before → after jump
const items = testimonials.filter(
  t => t.scoreBefore !== undefined && t.scoreAfter !== undefined
);

// Duplicate the list so the marquee can loop seamlessly
const loop = [...items, ...items];
---

<section class="bg-chalk border-y-2 border-ink py-5 overflow-hidden reveal" aria-label="Student score improvements">
  <div class="ticker group flex w-max items-center">
    {loop.map((t, i) => (
      <div
        class="ticker-item flex items-center gap-3 px-7 shrink-0"
        aria-hidden={i >= items.length ? 'true' : undefined}
      >
        <span class="font-bold text-ink whitespace-nowrap">{t.name.replace(/^Parent of /, '')}</span>
        <span class="bg-red-100 text-red-700 border border-red-300 text-sm font-black px-3 py-1 rounded-full">
          {t.scoreBefore}
        </span>
        <span class="text-ink/50 text-sm">→</span>
        <span class="bg-green-100 text-green-700 border border-green-300 text-sm font-black px-3 py-1 rounded-full">
          {t.scoreAfter}
        </span>
        <span class="text-ink/20 font-black pl-4 select-none">•</span>
      </div>
    ))}
  </div>
</section>

<style>
  .ticker {
    animation: ticker-scroll 60s linear infinite;
  }

  /* The duplicated half is exactly 50% of the track, so -50% loops seamlessly */
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker {
      animation: none;
    }
  }
</style>
