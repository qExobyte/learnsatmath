---
const stats = [
  { value: '400+', label: 'Students Helped' },
  { value: '750+', label: 'Average Masterclass Score' },
  { value: '120K', label: 'Subscribers on YouTube' },
  { value: '13M', label: 'Views on YouTube' },
];
---

<section class="bg-white border-y border-gray-100 py-10 reveal">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x lg:divide-gray-200">
      {stats.map(stat => (
        <div class="text-center lg:px-8">
          <dt class="font-serif text-3xl font-bold text-navy tracking-tight">{stat.value}</dt>
          <dd class="mt-1 text-sm text-gray-500 font-medium">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
