---
const stats = [
  { value: '400+', label: 'Students Helped' },
  { value: '750+', label: 'Average Masterclass Score' },
  { value: '125K', label: 'Subscribers on YouTube' },
  { value: '13M', label: 'Views on YouTube' },
];
---

<section class="bg-chalk border-y-2 border-ink py-10 reveal">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x-2 lg:divide-ink">
      {stats.map(stat => (
        <div class="text-center lg:px-8">
          <dt class="font-sans text-5xl font-black text-ink tracking-tight">{stat.value}</dt>
          <dd class="mt-1 text-xs font-bold uppercase tracking-widest text-ink">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
