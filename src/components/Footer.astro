---
const navLinks = [
  { label: 'Masterclass', href: '/masterclass' },
  { label: 'Tutoring', href: '/tutoring' },
  { label: 'Book', href: '/book' },
  { label: 'Resources', href: '/resources' },
];
---

<footer class="bg-ink-mid text-chalk/80">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-8">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="font-sans text-xl font-black text-chalk hover:text-electric transition-colors">
          LearnSATMath
        </a>
        <p class="mt-3 text-sm text-chalk/70 leading-relaxed max-w-xs">
          Expert SAT math instruction from a two-time perfect scorer. 400+ students helped.
        </p>
      </div>

      <!-- Nav links -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-chalk/50 mb-4">Pages</p>
        <ul class="space-y-2">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-chalk/70 hover:text-chalk transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-chalk/50 mb-4">Get Started</p>
        <p class="text-sm text-chalk/70 mb-4 leading-relaxed">
          The "study time calculator" will tell you exactly what you need to reach your goal score.
        </p>
        <a
          href="/calculator"
          class="inline-block bg-coral text-white text-sm font-bold px-6 py-3 rounded-xl border-2 border-chalk hover:opacity-90 transition-opacity"
        >
          Study Time Calculator
        </a>
        <p class="text-sm text-chalk/70 mt-6 leading-relaxed">
          Have a question? <a href="mailto:eric.wolpert@learnsatmath.com" class="text-chalk hover:text-electric transition-colors underline">Send me an email</a>.
        </p>
        <p class="text-sm text-chalk/50 mt-1">eric.wolpert [at] learnsatmath [dot] com</p>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-chalk/20 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-chalk/50">&copy; {new Date().getFullYear()} Bedrock Test Prep LLC. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="https://www.youtube.com/@learnsatmath" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-chalk/50 hover:text-chalk transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .6 5.8 3 3 0 0 0 2 2.1c2 .5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.8 15.5V8.5l6.2 3.5-6.2 3.5z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
