---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  video: string;
  ctaLabel: string;
  ctaHref: string;
  features?: string[];
  iconPath: string;
  iconBg?: string;
  reverse?: boolean;
  bg?: string;
  featuresCard?: boolean;
  id?: string;
}

const {
  eyebrow,
  title,
  description,
  video,
  ctaLabel,
  ctaHref,
  features = [],
  iconPath,
  iconBg = 'bg-electric',
  reverse = false,
  bg = 'bg-chalk',
  featuresCard = false,
  id,
} = Astro.props;

// Media-on-top on mobile; alternate sides on lg.
const mediaOrder = reverse ? 'lg:order-2' : 'lg:order-1';
const textOrder = reverse ? 'lg:order-1' : 'lg:order-2';
---

<section id={id} class={`py-14 lg:py-20 ${bg} reveal`}>
  <div class="max-w-5xl mx-auto px-6 lg:px-8 2xl:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Media -->
      <div class={mediaOrder}>
        <video
          src={video}
          autoplay
          loop
          muted
          playsinline
          class="w-full rounded-2xl border-2 border-ink shadow-offset-md"
        ></video>
      </div>

      <!-- Text -->
      <div class={textOrder}>
        <p class="text-xs font-bold uppercase tracking-widest text-ink/70 mb-3">{eyebrow}</p>
        <div class="flex items-center gap-4 mb-4">
          <div class={`w-12 h-12 rounded-xl border-2 border-ink shadow-offset-sm flex items-center justify-center flex-shrink-0 ${iconBg}`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
            </svg>
          </div>
          <h2 class="font-sans text-3xl lg:text-4xl font-extrabold text-ink tracking-tight">
            {title}
          </h2>
        </div>
        <p class="text-ink font-semibold text-lg leading-relaxed mb-6">{description}</p>
        {features.length > 0 && (
          <ul class={`space-y-3 mb-8${featuresCard ? ' bg-chalk rounded-2xl border-2 border-ink shadow-offset-sm p-6' : ''}`}>
            {features.map((f) => (
              <li class="flex items-start gap-2.5 text-base text-ink font-medium">
                <span class="text-coral font-black mt-0.5">✓</span>
                <span set:html={f} />
              </li>
            ))}
          </ul>
        )}
        <a
          href={ctaHref}
          data-cta-open
          class="cta-arrow group inline-flex items-center gap-2 bg-electric text-ink font-bold px-9 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          <span data-cta-label>{ctaLabel}</span>
          <svg data-cta-arrow xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../scripts/motion';

  // "Spring open" scroll-in for each CTA: the pill starts collapsed to a circle,
  // then springs open to the right (animating width with a back.out overshoot),
  // and the label + arrow reveal as a follow-up beat. The button's CSS hover
  // owns transform + shadow, so we clearProps afterwards to hand control back.
  if (!prefersReducedMotion()) {
    const buttons = gsap.utils.toArray<HTMLElement>('[data-cta-open]');
    buttons.forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-cta-label]');
      const arrow = btn.querySelector<HTMLElement>('[data-cta-arrow]');

      // Measure the natural width before collapsing, so we can spring back to it.
      const rect = btn.getBoundingClientRect();
      const open = rect.width;
      const closed = rect.height; // collapse to a circle (rounded-full)

      gsap.set(btn, {
        width: closed,
        overflow: 'hidden',
        whiteSpace: 'nowrap',
        transformOrigin: 'left center',
      });
      const content = [label, arrow].filter(Boolean);
      gsap.set(content, { opacity: 0 });

      ScrollTrigger.create({
        trigger: btn,
        start: 'top 88%',
        once: true,
        onEnter: () => {
          const tl = gsap.timeline({
            delay: 0.1,
            onComplete: () =>
              gsap.set([btn, ...content], { clearProps: 'all' }),
          });
          // The pill opens to the right in one smooth, continuous motion...
          tl.to(btn, { width: open, duration: 0.6, ease: 'power3.out' });
          // ...and the contents fade up together as it opens, so there's no
          // separate "second beat" — the reveal blends into the same gesture.
          tl.to(content, { opacity: 1, duration: 0.45, ease: 'power2.out' }, 0.18);
        },
      });
    });
  }
</script>
