---
interface Props {
  enrollHref: string;
  enrollLabel: string;
}

const { enrollHref, enrollLabel } = Astro.props;

interface Session {
  type: 'class' | 'office-hours';
  topic: string;
}

interface Week {
  number: number;
  name: string;
  sessions: Session[];
}

const weeks: Week[] = [
  {
    number: 1,
    name: 'Algebra with Desmos',
    sessions: [
      { type: 'class', topic: 'How to Prep & Functions' },
      { type: 'class', topic: 'Algebra w/ Desmos & Regressions' },
    ],
  },
  {
    number: 2,
    name: 'Linear & Exponential Functions',
    sessions: [
      { type: 'class', topic: 'Linear Functions' },
      { type: 'class', topic: 'Exponential Functions' },
      { type: 'office-hours', topic: 'Office Hours' },
    ],
  },
  {
    number: 3,
    name: 'Quadratics & Polynomials',
    sessions: [
      { type: 'class', topic: 'Quadratics' },
      { type: 'class', topic: 'Advanced Quadratics & Polynomials' },
    ],
  },
  {
    number: 4,
    name: 'Geometry',
    sessions: [
      { type: 'class', topic: 'Triangles' },
      { type: 'class', topic: 'Circles, Surface Area & Volume' },
      { type: 'office-hours', topic: 'Office Hours' },
    ],
  },
  {
    number: 5,
    name: 'Statistics & Review Game',
    sessions: [
      { type: 'class', topic: 'Unit Conversion & Statistics' },
      { type: 'class', topic: 'Final Review' },
      { type: 'office-hours', topic: 'Office Hours' },
    ],
  },
];
---

<section id="schedule" class="py-16 lg:py-24 bg-sky">
  <div class="max-w-xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-2">Cohort Schedule</h2>
      <p class="text-ink/60 text-xl font-semibold">5 weeks &middot; 10 live sessions</p>
      <p class="text-ink/60 text-xl font-semibold mt-1">All classes <span class="bg-electric text-ink font-black px-1">12:00 &ndash; 1:30 pm ET</span></p>
    </div>

    <div class="relative pl-6 border-l-2 border-ink flex flex-col gap-4">
      {weeks.map((week) => {
        const ohSessions = week.sessions.filter(s => s.type === 'office-hours');
        return (
          <div class="bg-white border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm transition-transform duration-200 hover:-translate-y-0.5">
            <p class="text-xs font-black uppercase tracking-widest text-ink/40 mb-1">Week {week.number}</p>
            <p class="font-sans text-lg text-ink font-bold leading-snug">{week.name}</p>
            {ohSessions.length > 0 && (
              <p class="text-sm text-ink/50 font-semibold italic mt-1">+ Office Hours</p>
            )}
          </div>
        );
      })}

      <!-- SAT -->
      <div class="bg-electric border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm">
        <p class="text-xs font-black uppercase tracking-widest text-ink/50 mb-1">SAT</p>
        <p class="font-sans text-lg text-ink font-black">Good luck!</p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href={enrollHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base uppercase tracking-wide"
      >
        {enrollLabel}
      </a>
    </div>
  </div>
</section>
