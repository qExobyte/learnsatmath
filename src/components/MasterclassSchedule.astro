---
interface Props {
  enrollHref: string;
  enrollLabel: string;
}

const { enrollHref, enrollLabel } = Astro.props;

interface Session {
  type: 'class' | 'office-hours';
  topic: string;
  detail?: string;
}

interface Week {
  number: number;
  name: string;
  date: string;
  sessions: Session[];
  timeNote?: string;
}

const weeks: Week[] = [
  {
    number: 1,
    name: 'Algebra with Desmos',
    date: 'Mon July 20 & Wed July 22',
    sessions: [
      { type: 'class', topic: 'How to Prep & Functions' },
      { type: 'class', topic: 'Algebra w/ Desmos & Regressions' },
      { type: 'office-hours', topic: 'Office Hours', detail: 'Tue, July 21 · 8:00 – 9:00 pm ET' },
    ],
  },
  {
    number: 2,
    name: 'Linear & Exponential Functions',
    date: 'Mon July 27 & Wed July 29',
    sessions: [
      { type: 'class', topic: 'Linear Functions' },
      { type: 'class', topic: 'Exponential Functions' },
      { type: 'office-hours', topic: 'Office Hours', detail: 'Tue, July 28 · 8:00 – 9:00 pm ET' },
    ],
  },
  {
    number: 3,
    name: 'Quadratics & Polynomials',
    date: 'Mon Aug 3 & Wed Aug 5',
    sessions: [
      { type: 'class', topic: 'Quadratics' },
      { type: 'class', topic: 'Advanced Quadratics & Polynomials' },
    ],
  },
  {
    number: 4,
    name: 'Geometry',
    date: 'Mon Aug 10 & Wed Aug 12',
    sessions: [
      { type: 'class', topic: 'Triangles' },
      { type: 'class', topic: 'Circles, Surface Area & Volume' },
      { type: 'office-hours', topic: 'Office Hours', detail: 'Sun, Aug 16 · 12:00 – 1:30 pm ET' },
    ],
  },
  {
    number: 5,
    name: 'Statistics & Review',
    date: 'Mon Aug 17 & Wed Aug 19',
    sessions: [
      { type: 'class', topic: 'Unit Conversion & Statistics' },
      { type: 'class', topic: 'Final Review' },
      { type: 'office-hours', topic: 'Office Hours', detail: 'Thu, Aug 20 · 8:00 – 9:00 pm ET' },
    ],
  },
];
---

<section id="schedule" class="py-12 lg:py-16 bg-sky">
  <div class="max-w-xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-2">Cohort Schedule</h2>
      <p class="text-ink/60 text-xl font-semibold">5 weeks &middot; 10 live sessions</p>
      <p class="text-ink/60 text-xl font-semibold mt-1">All classes <span class="bg-electric text-ink font-black px-1">8:00 &ndash; 9:30 pm ET</span></p>
    </div>

    <div class="relative pl-6 border-l-2 border-ink flex flex-col gap-4">
      {weeks.map((week) => {
        const ohSessions = week.sessions.filter(s => s.type === 'office-hours');
        return (
          <div class="bg-white border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm transition-transform duration-200 hover:-translate-y-0.5" data-schedule-item>
            <p class="text-xs font-black uppercase tracking-widest text-ink/60 mb-1">Week {week.number} &middot; {week.date}</p>
            <p class="font-sans text-lg text-ink font-bold leading-snug">{week.name}</p>
            {week.timeNote && (
              <p class="text-xs font-bold text-ink/70 mt-1">{week.timeNote}</p>
            )}
            {ohSessions.map((s) => (
              <p class="text-sm text-ink/50 font-semibold italic mt-1">
                + Office Hours{s.detail ? ` · ${s.detail}` : ''}
              </p>
            ))}
          </div>
        );
      })}

      <!-- SAT -->
      <div class="bg-electric border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm" data-schedule-item>
        <p class="text-xs font-black uppercase tracking-widest text-ink/50 mb-1">SAT &middot; august 22</p>
        <p class="font-sans text-lg text-ink font-black">Good luck!</p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <a
        href={enrollHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base tracking-wide"
      >
        {enrollLabel}
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  if (!prefersReducedMotion()) {
    const items = gsap.utils.toArray<HTMLElement>('[data-schedule-item]');
    gsap.set(items, { y: 40, opacity: 0 });
    gsap.to(items, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'back.out(1.4)',
      stagger: 0.12,
      clearProps: 'transform,opacity',
      scrollTrigger: { trigger: '#schedule', start: 'top 70%', once: true },
    });
  }
</script>
