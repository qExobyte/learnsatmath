---
// Week-by-week curriculum for the October cohort.
// Data lives in src/data/schedule.ts (shared with /masterclass/thanks).
import { weeks, cohorts } from '../data/schedule';

const cohort = cohorts.find((c) => c.id === 'oct')!;
---

<section id="schedule" class="py-12 lg:py-16 bg-sky">
  <div class="max-w-xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight">Cohort Schedule</h2>
    </div>

    <div class="text-center mb-8">
      <p class="mb-2">
        <span class="bg-electric text-ink text-lg lg:text-xl font-black box-decoration-clone px-2 py-1">5 weeks &middot; 10 live sessions</span>
      </p>
      <p class="text-ink/60 text-xl font-semibold" set:html={cohort.time} />
    </div>

    <div class="flex flex-col gap-4">
      {weeks.map((week, wi) => (
        <div class="relative bg-white border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm transition-transform duration-200 hover:-translate-y-0.5" data-schedule-item>
          <p class="flex justify-between gap-2 text-xs font-black uppercase tracking-widest text-ink/60 mb-1">
            <span>Week {week.number} &middot; {cohort.weekDates[wi]}</span>
            {week.number >= cohort.officeHoursFromWeek && <span class="text-ink/40">+ office hours</span>}
          </p>
          <p class="font-sans text-lg text-ink font-bold leading-snug">{week.name}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="#interest-form"
        class="inline-flex items-center gap-2 bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base tracking-wide"
      >
        Reserve Your Spot
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  if (!prefersReducedMotion()) {
    const items = gsap.utils.toArray<HTMLElement>('[data-schedule-item]');
    gsap.set(items, { y: 40, opacity: 0 });
    gsap.to(items, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'back.out(1.4)',
      stagger: 0.12,
      clearProps: 'transform,opacity',
      scrollTrigger: { trigger: '#schedule', start: 'top 70%', once: true },
    });
  }
</script>
