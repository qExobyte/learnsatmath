---
// Week-by-week curriculum, with a toggle between the two upcoming cohorts.
// Data lives in src/data/schedule.ts (shared with /masterclass/thanks).
import { weeks, cohorts } from '../data/schedule';
---

<section id="schedule" class="py-12 lg:py-16 bg-sky">
  <div class="max-w-xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-8">
      <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-2">Cohort Schedule</h2>
      <p class="text-ink/60 text-xl font-semibold">5 weeks &middot; 10 live sessions</p>
    </div>

    <!-- Cohort toggle -->
    <div class="flex justify-center mb-8">
      <div class="inline-flex border-2 border-ink rounded-full p-1 bg-white shadow-offset-sm">
        {cohorts.map((cohort, i) => (
          <button
            data-cohort-tab={cohort.id}
            class:list={[
              'px-6 py-2 rounded-full font-sans font-bold text-sm uppercase tracking-wide transition-colors duration-200',
              i === 0 ? 'bg-ink text-chalk' : 'bg-transparent text-ink',
            ]}
          >
            {cohort.label}
          </button>
        ))}
      </div>
    </div>

    {cohorts.map((cohort, i) => (
      <div data-cohort-panel={cohort.id} class:list={[i !== 0 && 'hidden']}>
        <p class="text-center mb-8">
          <span class="bg-electric text-ink text-lg lg:text-xl font-black box-decoration-clone px-2 py-1" set:html={cohort.time} />
        </p>

        <div class="flex flex-col gap-4">
          {weeks.map((week, wi) => (
            <div class="relative bg-white border-2 border-ink rounded-2xl px-5 py-4 shadow-offset-sm transition-transform duration-200 hover:-translate-y-0.5" data-schedule-item>
              <p class="flex justify-between gap-2 text-xs font-black uppercase tracking-widest text-ink/60 mb-1">
                <span>Week {week.number} &middot; {cohort.weekDates[wi]}</span>
                {week.number >= cohort.officeHoursFromWeek && <span class="text-ink/40">+ office hours</span>}
              </p>
              <p class="font-sans text-lg text-ink font-bold leading-snug">{week.name}</p>
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-12 text-center">
      <a
        href="#interest-form"
        class="inline-flex items-center gap-2 bg-coral text-white font-black px-10 py-4 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base tracking-wide"
      >
        Reserve Your Spot
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cohort-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-cohort-panel]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.cohortTab;
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('bg-ink', active);
        t.classList.toggle('text-chalk', active);
        t.classList.toggle('bg-transparent', !active);
        t.classList.toggle('text-ink', !active);
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.dataset.cohortPanel !== id));
    });
  });

  if (!prefersReducedMotion()) {
    const items = gsap.utils.toArray<HTMLElement>('[data-schedule-item]');
    gsap.set(items, { y: 40, opacity: 0 });
    gsap.to(items, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'back.out(1.4)',
      stagger: 0.12,
      clearProps: 'transform,opacity',
      scrollTrigger: { trigger: '#schedule', start: 'top 70%', once: true },
    });
  }
</script>
