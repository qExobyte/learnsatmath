---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Masterclass', href: '/masterclass' },
  { label: 'Tutoring', href: '/tutoring' },
  { label: 'Book', href: '/book' },
  { label: 'Resources', href: '/resources' },
];

const currentPath = Astro.url.pathname;
---

<nav class="bg-chalk sticky top-0 z-50 border-b-2 border-ink">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 2xl:px-12">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity shrink-0">
        <img src="/lsmlogo-navy-transparent.svg" alt="LearnSATMath" class="h-8 w-8" />
        <span class="font-sans text-xl font-black text-ink tracking-tight">LearnSATMath</span>
      </a>

      <!-- Desktop nav: links centered, enroll button pinned right -->
      <div class="hidden lg:flex flex-1 items-center justify-center gap-7">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-sm font-semibold transition-colors ${
              currentPath === link.href
                ? 'text-coral'
                : 'text-ink hover:text-coral'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button
        id="hamburger"
        class="lg:hidden text-ink p-2 rounded hover:bg-ink/10 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t-2 border-ink">
    <div class="px-6 py-4 flex flex-col gap-3">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm font-semibold py-1 transition-colors ${
            currentPath === link.href
              ? 'text-coral'
              : 'text-ink hover:text-coral'
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  hamburger?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    hamburger.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
