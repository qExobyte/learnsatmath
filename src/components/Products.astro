---
import MasterclassIncluded from './MasterclassIncluded.astro';
import CoachingFeatures from './CoachingFeatures.astro';
import { MASTERCLASS_PRICE, COACHING_STARTING_PRICE } from '../data/pricing';

const book = {
  name: 'SAT Math from the Ground Up',
  price: '$49',
  tagline: 'Master the concepts',
  features: [
    '110-page comprehensive ebook',
    '240+ conceptual questions with explanations',
    '25 challenging SAT-style problems',
    'Desmos tricks and procedures',
    'Complete formula list',
  ],
  cta: 'Learn More',
  href: '/book',
};

const masterclass = {
  name: 'Masterclass',
  price: `$${MASTERCLASS_PRICE}`,
  priceNote: '$49 per hour',
  tagline: 'Live small group classes',
  badge: 'Best Results',
  cta: 'Learn More',
  href: '/masterclass',
};

const coaching = {
  name: '1-on-1 Coaching',
  price: `$${COACHING_STARTING_PRICE}`,
  priceNote: 'starting price',
  tagline: 'Full-service prep',
  cta: 'Learn More',
  href: '/tutoring#pricing',
};
---

<section id="pricing" class="py-20 lg:py-28 bg-peach">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight mb-3">Choose your path to an 800</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:items-stretch">

      <!-- Book -->
      <div data-price-card class="bg-white rounded-2xl border-2 border-ink shadow-offset-md p-8 flex flex-col hover:-translate-y-1 transition-transform duration-200">
        <div class="mb-6">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl border-2 border-ink shadow-offset-sm flex items-center justify-center flex-shrink-0 bg-sky">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-ink/50 mb-1">{book.tagline}</p>
              <h3 class="font-sans text-xl text-ink font-bold">{book.name}</h3>
            </div>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-sans text-4xl font-black text-ink">{book.price}</span>
          </div>
        </div>
        <ul class="flex-1 space-y-3 mb-8">
          {book.features.map(f => (
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={book.href}
          class="block text-center border-2 border-ink text-ink font-bold py-3 rounded-xl hover:bg-ink hover:text-chalk transition-colors shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          {book.cta}
        </a>
      </div>

      <!-- Masterclass (featured) -->
      <div data-price-card class="bg-ink-mid rounded-2xl border-2 border-coral p-8 flex flex-col lg:-my-4 shadow-[5px_5px_0_0_#FF5533] relative z-10 hover:-translate-y-1 transition-transform duration-200">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <span class="bg-electric text-ink text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full border-2 border-ink">
            {masterclass.badge}
          </span>
        </div>
        <div class="mb-6 mt-4">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl border-2 border-ink shadow-offset-sm flex items-center justify-center flex-shrink-0 bg-electric">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-chalk/60 mb-1">{masterclass.tagline}</p>
              <h3 class="font-sans text-2xl text-chalk font-bold">{masterclass.name}</h3>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-sans text-4xl font-black text-chalk">{masterclass.price}</span>
            <span class="text-chalk/60 text-sm">{masterclass.priceNote}</span>
          </div>
        </div>
        <div class="flex-1 mb-8">
          <MasterclassIncluded dark={true} />
        </div>
        <a
          href={masterclass.href}
          class="block text-center bg-coral text-white font-bold py-3 rounded-xl border-2 border-chalk hover:opacity-90 transition-opacity"
        >
          {masterclass.cta}
        </a>
      </div>

      <!-- Coaching -->
      <div data-price-card class="bg-white rounded-2xl border-2 border-ink shadow-offset-md p-8 flex flex-col hover:-translate-y-1 transition-transform duration-200">
        <div class="mb-6">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl border-2 border-ink shadow-offset-sm flex items-center justify-center flex-shrink-0 bg-coral">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-ink/50 mb-1">{coaching.tagline}</p>
              <h3 class="font-sans text-xl text-ink font-bold">{coaching.name}</h3>
            </div>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-sans text-4xl font-black text-ink">{coaching.price}</span>
            <span class="text-ink/50 text-sm">{coaching.priceNote}</span>
          </div>
        </div>
        <div class="flex-1 mb-8">
          <CoachingFeatures dark={false} />
        </div>
        <a
          href={coaching.href}
          class="block text-center border-2 border-ink text-ink font-bold py-3 rounded-xl hover:bg-ink hover:text-chalk transition-colors shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          {coaching.cta}
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Final states live in the markup; GSAP only hides things when it will
  // animate them, so no-JS and reduced-motion users see the complete section.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cards = gsap.utils.toArray<HTMLElement>('[data-price-card]');

    gsap.set(cards, { y: 40, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: '#pricing', start: 'top 70%', once: true },
    });

    // Side cards land first, the featured middle card last
    const ordered = [cards[0], cards[2], cards[1]].filter(Boolean);
    tl.to(ordered, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'back.out(1.4)',
      stagger: 0.15,
      clearProps: 'transform,opacity', // restore CSS hover lift after landing
    });
  }
</script>
