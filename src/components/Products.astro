---
import MasterclassIncluded from './MasterclassIncluded.astro';

const book = {
  name: 'SAT Math from the Ground Up',
  price: '$49',
  tagline: 'Master the concepts',
  features: [
    '110-page comprehensive ebook',
    '240+ conceptual questions with explanations',
    '25 challenging SAT-style problems',
    'Desmos tricks and procedures',
    'Complete formula list',
  ],
  cta: 'Learn More',
  href: '/book',
};

const masterclass = {
  name: 'Masterclass',
  price: '$895',
  priceNote: '$49 per hour',
  tagline: 'Live small group classes',
  badge: 'Best Results',
  cta: 'Learn More',
  href: '/masterclass',
};

const oneOnOne = {
  name: '1-on-1 Sessions',
  price: '$285',
  priceNote: 'per hour',
  tagline: 'Personalized instruction',
  features: [
    'Flexible on-demand scheduling',
    'Personalized to your weaknesses',
    'Master the Desmos calculator',
    'SAT Math from the Ground Up book included',
    'Setup a structured plan for your prep',
  ],
  cta: 'Book a Session',
  href: '/tutoring',
};
---

<section id="pricing" class="py-20 lg:py-28 bg-peach reveal">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="font-sans text-3xl lg:text-5xl font-extrabold text-ink tracking-tight mb-3">Choose your path to an 800</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:items-stretch">

      <!-- Book -->
      <div class="bg-white rounded-2xl border-2 border-ink shadow-offset-md p-8 flex flex-col hover:-translate-y-1 transition-transform duration-200">
        <div class="mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-ink/50 mb-2">{book.tagline}</p>
          <h3 class="font-sans text-xl text-ink font-bold mb-4">{book.name}</h3>
          <div class="flex items-baseline gap-1">
            <span class="font-sans text-4xl font-black text-ink">{book.price}</span>
          </div>
        </div>
        <ul class="flex-1 space-y-3 mb-8">
          {book.features.map(f => (
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={book.href}
          class="block text-center border-2 border-ink text-ink font-bold py-3 rounded-xl hover:bg-ink hover:text-chalk transition-colors shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          {book.cta}
        </a>
      </div>

      <!-- Masterclass (featured) -->
      <div class="bg-ink-mid rounded-2xl border-2 border-coral p-8 flex flex-col lg:-my-4 shadow-[5px_5px_0_0_#FF5533] relative z-10 hover:-translate-y-1 transition-transform duration-200">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <span class="bg-electric text-ink text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full border-2 border-ink">
            {masterclass.badge}
          </span>
        </div>
        <div class="mb-6 mt-4">
          <p class="text-xs font-bold uppercase tracking-widest text-chalk/60 mb-2">{masterclass.tagline}</p>
          <h3 class="font-sans text-2xl text-chalk font-bold mb-4">{masterclass.name}</h3>
          <div class="flex items-baseline gap-2">
            <span class="font-sans text-4xl font-black text-chalk">{masterclass.price}</span>
            <span class="text-chalk/60 text-sm">{masterclass.priceNote}</span>
          </div>
        </div>
        <div class="flex-1 mb-8">
          <MasterclassIncluded dark={true} />
        </div>
        <a
          href={masterclass.href}
          class="block text-center bg-coral text-white font-bold py-3 rounded-xl border-2 border-chalk hover:opacity-90 transition-opacity"
        >
          {masterclass.cta}
        </a>
      </div>

      <!-- 1-on-1 -->
      <div class="bg-white rounded-2xl border-2 border-ink shadow-offset-md p-8 flex flex-col hover:-translate-y-1 transition-transform duration-200">
        <div class="mb-6">
          <p class="text-xs font-bold uppercase tracking-widest text-ink/50 mb-2">{oneOnOne.tagline}</p>
          <h3 class="font-sans text-xl text-ink font-bold mb-4">{oneOnOne.name}</h3>
          <div class="flex items-baseline gap-2">
            <span class="font-sans text-4xl font-black text-ink">{oneOnOne.price}</span>
            <span class="text-ink/50 text-sm">{oneOnOne.priceNote}</span>
          </div>
        </div>
        <ul class="flex-1 space-y-3 mb-8">
          {oneOnOne.features.map(f => (
            <li class="flex items-start gap-2 text-base text-ink/80">
              <span class="text-coral font-black mt-0.5">✓</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={oneOnOne.href}
          class="block text-center border-2 border-ink text-ink font-bold py-3 rounded-xl hover:bg-ink hover:text-chalk transition-colors shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
        >
          {oneOnOne.cta}
        </a>
      </div>

    </div>
  </div>
</section>
