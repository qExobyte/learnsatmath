---
interface Props {
  bg?: string;
}
const { bg = 'bg-chalk' } = Astro.props;
---

<section class={`${bg} border-b-2 border-ink py-8`}>
  <div class="max-w-4xl mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <p class="font-sans font-extrabold text-xl text-ink">Not sure how much to prepare?</p>
      <p class="text-ink/60 font-semibold text-base">Use the study time calculator to estimate the hours needed to reach your goal.</p>
    </div>
    <a
      href="/calculator"
      class="flex-shrink-0 bg-transparent text-ink font-bold text-lg py-4 px-9 rounded-full border-2 border-ink shadow-offset-sm hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
    >
      Score Calculator →
    </a>
  </div>
</section>
