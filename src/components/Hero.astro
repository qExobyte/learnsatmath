---
---

<section class="bg-ink-mid text-chalk py-24 lg:py-32 hero-section">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <h1 class="font-sans text-4xl lg:text-6xl font-black leading-tight tracking-tight mb-6 max-w-3xl" data-hero-item>
      I've helped over 400 students achieve their <span class="relative inline-block text-ink px-2 -rotate-1"><span class="absolute inset-0 bg-electric" data-hero-marker aria-hidden="true"></span><span class="relative">top SAT math score.</span></span>
    </h1>
    <p class="text-chalk/80 text-lg font-semibold leading-relaxed mb-10 max-w-2xl" data-hero-item>
      Hi, I'm <a href="https://www.youtube.com/@learnsatmath" target="blank" class="underline hover:text-electric transition-colors">Eric</a>. I earned a perfect SAT math score twice and have spent four years teaching students how to master the test.
    </p>
    <div class="flex flex-wrap gap-4" data-hero-item>
      <a
        href="/masterclass"
        class="bg-coral text-white font-bold px-8 py-4 rounded-xl border-2 border-chalk shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base"
      >
        Check out the Masterclass
      </a>
      <a
        href="#pricing"
        id="see-all-options"
        class="border-2 border-chalk text-chalk font-bold px-8 py-4 rounded-xl shadow-[3px_3px_0_0_rgba(247,246,242,0.4)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200 text-base"
      >
        See all options
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2rem, 11vh, 8rem);
    padding-bottom: clamp(2rem, 11vh, 8rem);
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  document.getElementById('see-all-options')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.getElementById('pricing')?.scrollIntoView({ behavior: 'smooth' });
  });

  if (!prefersReducedMotion()) {
    const items = gsap.utils.toArray<HTMLElement>('[data-hero-item]');
    const marker = document.querySelector('[data-hero-marker]');
    gsap.set(items, { y: 24, opacity: 0 });
    if (marker) gsap.set(marker, { scaleX: 0, transformOrigin: 'left center' });
    const tl = gsap.timeline();
    tl.to(items, {
      y: 0,
      opacity: 1,
      duration: 0.6,
      ease: 'power3.out',
      stagger: 0.12,
      clearProps: 'transform,opacity',
    });
    if (marker) tl.to(marker, { scaleX: 1, duration: 0.5, ease: 'power2.inOut' }, '-=0.3');
  }
</script>
