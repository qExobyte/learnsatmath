<section class="bg-navy text-white py-24 lg:py-32">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <h1 class="font-serif text-4xl lg:text-6xl leading-tight tracking-tight mb-6 max-w-3xl">
      I've helped over 400 students achieve their top SAT math score.
    </h1>
    <!--
    <p class="text-blue-100 text-lg leading-relaxed mb-10 max-w-2xl">
      Hi, I'm Eric. I earned a perfect SAT math score twice and have spent four years developing
      scientifically based strategies that consistently produce results on the digital SAT.
    </p>
    -->
    <div class="flex flex-wrap gap-4">
      <a
        href="/masterclass"
        class="bg-cta text-white font-semibold px-8 py-4 rounded-full hover:bg-orange-700 transition-colors text-base"
      >
        Enroll in Masterclass
      </a>
      <a
        href="#pricing"
        id="see-all-options"
        class="border border-white text-white font-semibold px-8 py-4 rounded-full hover:bg-white/10 transition-colors text-base"
      >
        See all options
      </a>
    </div>
  </div>
