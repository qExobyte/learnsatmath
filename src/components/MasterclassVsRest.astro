---
import { bedrockProblems } from '../data/bedrockProblems';

// Leaderboard snapshot shown on the third carousel slide. Mock data — purely
// illustrative of the in-class cash-prize competition.
const leaders = [
  { rank: 1, name: 'Priya S.', points: 64, prize: 50, bar: 'bg-coral' },
  { rank: 2, name: 'Marcus T.', points: 55, prize: 40, bar: 'bg-electric' },
  { rank: 3, name: 'Ava L.', points: 48, prize: 30, bar: 'bg-sky' },
];
const maxPoints = Math.max(...leaders.map((l) => l.points));

// Slide 4: Bedrock Pro teaser. Same tile/lockup language and difficulty colors
// as /bedrock (diffBg mirrors the platform's DIFFICULTY_TILE_STYLES).
const diffBg: Record<string, string> = {
  easy: 'bg-green-100 text-green-700',
  medium: 'bg-amber-100 text-amber-700',
  hard: 'bg-red-100 text-red-600',
};
const bedrockTeaser = bedrockProblems.slice(0, 30);
---

<section class="py-12 lg:py-16 bg-peach overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <div class="relative flex items-center gap-3 sm:gap-4">

      <!-- Left arrow (flanks the media on desktop; drops below on mobile) -->
      <button
        aria-label="Previous"
        class="vs-prev hidden sm:flex shrink-0 bg-white border-2 border-ink shadow-offset-sm rounded-full w-11 h-11 items-center justify-center text-ink hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Viewport -->
      <div class="flex-1 min-w-0 overflow-hidden">
        <div id="vs-track" class="flex transition-transform duration-300 ease-in-out">

          <!-- Slide 1: class size + format sizzle -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Only a few students per cohort
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  Spots are limited to just <strong class="text-ink">15 ambitious students</strong> so sessions
                  feel like <strong class="text-ink">discussions, not lectures</strong>. Every student
                  participates and asks questions.
                </p>
              </div>
              <video
                src="/masterclass_clips.mp4"
                autoplay
                loop
                muted
                playsinline
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md"
              ></video>
            </div>
          </div>

          <!-- Slide 2: Desmos sizzle -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Master the Desmos tricks most courses ignore
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  To solve the hardest SAT problems and cut down on time, students master every
                  Desmos trick that CollegeBoard won&rsquo;t share.
                </p>
              </div>
              <video
                src="/desmos_sizzle.mp4"
                autoplay
                loop
                muted
                playsinline
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md"
              ></video>
            </div>
          </div>

          <!-- Slide 3: leaderboard snapshot -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Stay accountable
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  We&rsquo;ll have homework assignments and regular check-ins to ensure you&rsquo;re
                  on track for your goal score. There are also <strong class="text-ink">cash
                  prizes</strong> for participation!
                </p>
              </div>

              <div
                id="vs-leaderboard"
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md bg-white p-6 sm:p-8 flex flex-col gap-4 text-left"
              >
                {leaders.map((l) => (
                  <div class="vs-lb-row flex flex-col gap-1.5">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="inline-flex items-center gap-2 font-extrabold text-ink text-base sm:text-lg">
                        <span class="inline-flex items-center justify-center w-6 h-6 shrink-0 text-xs font-black border-2 border-ink rounded-full bg-white">
                          {l.rank}
                        </span>
                        {l.name}
                        <span class="inline-flex items-center gap-1 text-xs font-black px-2 py-0.5 border-2 border-ink rounded-full bg-chalk whitespace-nowrap">
                          💰 ${l.prize}
                        </span>
                      </span>
                      <span class="font-extrabold text-ink text-sm sm:text-base whitespace-nowrap">
                        {l.points} <span class="font-semibold text-ink/50 text-xs">pts</span>
                      </span>
                    </div>
                    <div class="h-6 border-2 border-ink rounded-full bg-white shadow-offset-sm overflow-hidden">
                      <div
                        class={`vs-lb-bar h-full rounded-full ${l.bar}`}
                        data-width={`${Math.round((l.points / maxPoints) * 100)}%`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Slide 4: Bedrock Pro, lifetime -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Lifetime access to Bedrock Pro
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  Every student gets Bedrock Pro <strong class="text-ink">for life</strong>: 125 problem
                  types, video lessons, and 600+ variations. Keep drilling long
                  after the cohort ends.
                </p>
              </div>

              <div
                id="vs-bedrock"
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md bg-white p-5 sm:p-6 flex flex-col items-center gap-5"
              >
                <!-- The Bedrock 125 lockup: bars rise, numeral counts up (ported from /bedrock) -->
                <svg
                  id="vs-bp-lockup"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 336 120"
                  fill="none"
                  role="img"
                  aria-label="The Bedrock 125"
                  class="h-auto w-[220px] sm:w-[280px]"
                >
                  <g stroke="#141414" stroke-width="3" stroke-linejoin="round">
                    <rect class="vs-bp-bar" x="2" y="62" width="17" height="56" rx="3" fill="#16A34A" />
                    <rect class="vs-bp-bar" x="29" y="42" width="17" height="76" rx="3" fill="#F59E0B" />
                    <rect class="vs-bp-bar" x="56" y="22" width="17" height="96" rx="3" fill="#EE4E29" />
                    <rect class="vs-bp-bar" x="83" y="2" width="17" height="116" rx="3" fill="#9333EA" />
                  </g>
                  <text x="130" y="34" font-family="'DM Sans', system-ui, sans-serif" font-weight="800" font-size="15" letter-spacing="1.1" fill="#141414">THE BEDROCK</text>
                  <text id="vs-bp-count" x="127" y="107" font-family="'DM Sans', system-ui, sans-serif" font-weight="900" font-size="76" letter-spacing="-2" fill="#141414">125</text>
                </svg>

                <!-- Problem-grid teaser: 3 rows, fading out to say "there are more" -->
                <div class="vs-bp-grid-mask w-full">
                  <div id="vs-bp-grid" class="vs-bp-grid" aria-label="The first 30 of the 125 Bedrock problems, colored by difficulty">
                    {bedrockTeaser.map((p) => (
                      <div
                        class={`vs-bp-tile ${diffBg[p.d]} aspect-square rounded-md sm:rounded-lg border-2 border-ink shadow-offset-sm flex items-center justify-center font-sans font-black text-[10px] sm:text-[12px] select-none`}
                        title={`#${p.n} ${p.name} — ${p.d} · ${p.v} variations`}
                      >
                        {p.n}
                      </div>
                    ))}
                  </div>
                </div>

                <a href="/bedrock" class="font-sans font-bold text-sm text-ink hover:text-coral transition-colors">
                  See what&rsquo;s inside Bedrock &rarr;
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right arrow (nudges to invite a click) -->
      <button
        aria-label="Next"
        class="vs-next vs-nudge hidden sm:flex shrink-0 bg-white border-2 border-ink shadow-offset-sm rounded-full w-11 h-11 items-center justify-center text-ink hover:shadow-none transition-shadow duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Controls: dots always; arrows flank the dots on mobile (they flank the media on desktop) -->
    <div class="flex justify-center items-center gap-4 mt-8">
      <!-- Left arrow (mobile only) -->
      <button
        aria-label="Previous"
        class="vs-prev flex sm:hidden shrink-0 bg-white border-2 border-ink shadow-offset-sm rounded-full w-11 h-11 items-center justify-center text-ink hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <div class="flex gap-2.5">
        <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-ink transition-colors" aria-label="Go to slide 1"></button>
        <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-white transition-colors" aria-label="Go to slide 2"></button>
        <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-white transition-colors" aria-label="Go to slide 3"></button>
        <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-white transition-colors" aria-label="Go to slide 4"></button>
      </div>

      <!-- Right arrow (mobile only) -->
      <button
        aria-label="Next"
        class="vs-next vs-nudge flex sm:hidden shrink-0 bg-white border-2 border-ink shadow-offset-sm rounded-full w-11 h-11 items-center justify-center text-ink hover:shadow-none transition-shadow duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  @keyframes vsNudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  .vs-nudge { animation: vsNudge 1.1s ease-in-out infinite; }

  .vs-lb-row {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .vs-lb-row.is-in {
    opacity: 1;
    transform: translateY(0);
  }
  .vs-lb-bar {
    width: 0;
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Bedrock Pro slide — same tile language as /bedrock. */
  .vs-bp-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(10, minmax(0, 1fr));
  }
  .vs-bp-grid-mask {
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 99%);
    mask-image: linear-gradient(180deg, #000 60%, transparent 99%);
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-nudge { animation: none; }
    .vs-lb-row, .vs-lb-bar { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const track = document.getElementById('vs-track');
    const prevBtns = Array.from(document.querySelectorAll('.vs-prev'));
    const nextBtns = Array.from(document.querySelectorAll('.vs-next'));
    const board = document.getElementById('vs-leaderboard');
    const dots = Array.from(document.querySelectorAll('.vs-dot'));
    if (!track) return;

    const COUNT = 4;
    let index = 0;
    let nudged = false;

    function revealLeaderboard() {
      if (!board) return;
      const rows = Array.from(board.querySelectorAll('.vs-lb-row'));
      // reset, then stagger in so it reads like the sizzle reels
      rows.forEach((row) => {
        row.classList.remove('is-in');
        const bar = row.querySelector('.vs-lb-bar');
        if (bar) bar.style.width = '0';
      });
      rows.forEach((row, i) => {
        setTimeout(() => {
          row.classList.add('is-in');
          const bar = row.querySelector('.vs-lb-bar');
          if (bar) bar.style.width = bar.getAttribute('data-width') || '0';
        }, 120 + i * 280);
      });
    }

    function update() {
      track.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-ink', i === index);
        dot.classList.toggle('bg-white', i !== index);
      });
      if (index === 2) revealLeaderboard();
      // The Bedrock slide's GSAP choreography lives in the bundled script below.
      document.dispatchEvent(new CustomEvent('vs:slide', { detail: { index } }));
    }

    function go(to) {
      index = (to + COUNT) % COUNT;
      update();
    }

    function stopNudge() {
      if (nudged) return;
      nudged = true;
      nextBtns.forEach((btn) => btn.classList.remove('vs-nudge'));
    }

    prevBtns.forEach((btn) => btn.addEventListener('click', () => { stopNudge(); go(index - 1); }));
    nextBtns.forEach((btn) => btn.addEventListener('click', () => { stopNudge(); go(index + 1); }));
    dots.forEach((dot, i) => dot.addEventListener('click', () => { stopNudge(); go(i); }));

    update();
  })();
</script>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  // Slide 4 choreography, ported from /bedrock: bars rise + "125" counts up
  // and the problem tiles pop in from random spots. Replays every time the
  // slide comes into view. Final states live in the markup; reduced-motion
  // users just see them.
  const card = document.getElementById('vs-bedrock');
  if (card && !prefersReducedMotion()) {
    const bars = gsap.utils.toArray<SVGRectElement>('.vs-bp-bar');
    const count = document.getElementById('vs-bp-count');
    const grid = document.getElementById('vs-bp-grid');
    const barGeom = bars.map((b) => ({ y: Number(b.getAttribute('y')), h: Number(b.getAttribute('height')) }));

    let tl: gsap.core.Timeline | null = null;

    function hide() {
      bars.forEach((b, i) => gsap.set(b, { attr: { y: barGeom[i].y + barGeom[i].h, height: 0 }, opacity: 0 }));
      if (grid) gsap.set(grid.children, { opacity: 0, scale: 0 });
    }

    function play() {
      tl?.kill();
      hide();
      tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      bars.forEach((bar, i) => {
        tl!.to(bar, { attr: { y: barGeom[i].y, height: barGeom[i].h }, opacity: 1, duration: 0.55, ease: 'back.out(1.4)' }, 0.1 + i * 0.09);
      });
      if (count) {
        const n = { v: 0 };
        tl.to(n, { v: 125, duration: 1.1, ease: 'power2.out', onUpdate: () => { count.textContent = String(Math.round(n.v)); } }, 0.1);
      }
      if (grid) {
        tl.to(
          grid.children,
          { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(2)', stagger: { each: 0.02, from: 'random' }, clearProps: 'transform' },
          0.45,
        );
      }
    }

    hide();
    document.addEventListener('vs:slide', (e) => {
      const { index } = (e as CustomEvent<{ index: number }>).detail;
      if (index === 3) play();
    });
  }
</script>
