---
// Leaderboard snapshot shown on the third carousel slide. Mock data — purely
// illustrative of the in-class cash-prize competition.
const leaders = [
  { rank: 1, name: 'Priya S.', points: 64, prize: 50, bar: 'bg-coral' },
  { rank: 2, name: 'Marcus T.', points: 55, prize: 40, bar: 'bg-electric' },
  { rank: 3, name: 'Ava L.', points: 48, prize: 30, bar: 'bg-sky' },
];
const maxPoints = Math.max(...leaders.map((l) => l.points));
---

<section class="py-12 lg:py-16 bg-peach overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <div class="relative flex items-center gap-3 sm:gap-4">

      <!-- Left arrow -->
      <button
        id="vs-prev"
        aria-label="Previous"
        class="shrink-0 bg-white border-2 border-ink shadow-offset-sm rounded-full w-11 h-11 flex items-center justify-center text-ink hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] transition-all duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Viewport -->
      <div class="flex-1 min-w-0 overflow-hidden">
        <div id="vs-track" class="flex transition-transform duration-300 ease-in-out">

          <!-- Slide 1: class size + format sizzle -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Small cohort, real discussion
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  Just <strong class="text-ink">8&ndash;15 students</strong> per cohort in a
                  <strong class="text-ink">discussion-based</strong> class where every student
                  participates and asks questions as needed.
                </p>
              </div>
              <video
                src="/masterclass_clips.mp4"
                autoplay
                loop
                muted
                playsinline
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md"
              ></video>
            </div>
          </div>

          <!-- Slide 2: Desmos sizzle -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Master the Desmos tricks most courses ignore
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  To solve the hardest SAT problems and cut down on time, students master every
                  Desmos trick that CollegeBoard won&rsquo;t share.
                </p>
              </div>
              <video
                src="/desmos_sizzle.mp4"
                autoplay
                loop
                muted
                playsinline
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md"
              ></video>
            </div>
          </div>

          <!-- Slide 3: leaderboard snapshot -->
          <div class="shrink-0 w-full px-2 pb-2">
            <div class="flex flex-col items-center text-center gap-6 h-full justify-center">
              <div class="max-w-2xl">
                <h3 class="font-sans text-2xl lg:text-3xl font-extrabold text-ink tracking-tight">
                  Stay accountable
                </h3>
                <p class="mt-3 text-ink/70 font-semibold text-base lg:text-lg leading-relaxed">
                  We&rsquo;ll have homework assignments and regular check-ins to ensure you&rsquo;re
                  on track for your goal score. There are also <strong class="text-ink">cash
                  prizes</strong> for participation!
                </p>
              </div>

              <div
                id="vs-leaderboard"
                class="w-full max-w-2xl rounded-2xl border-2 border-ink shadow-offset-md bg-white p-6 sm:p-8 flex flex-col gap-4 text-left"
              >
                {leaders.map((l) => (
                  <div class="vs-lb-row flex flex-col gap-1.5">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="inline-flex items-center gap-2 font-extrabold text-ink text-base sm:text-lg">
                        <span class="inline-flex items-center justify-center w-6 h-6 shrink-0 text-xs font-black border-2 border-ink rounded-full bg-white">
                          {l.rank}
                        </span>
                        {l.name}
                        <span class="inline-flex items-center gap-1 text-xs font-black px-2 py-0.5 border-2 border-ink rounded-full bg-chalk whitespace-nowrap">
                          💰 ${l.prize}
                        </span>
                      </span>
                      <span class="font-extrabold text-ink text-sm sm:text-base whitespace-nowrap">
                        {l.points} <span class="font-semibold text-ink/50 text-xs">pts</span>
                      </span>
                    </div>
                    <div class="h-6 border-2 border-ink rounded-full bg-white shadow-offset-sm overflow-hidden">
                      <div
                        class={`vs-lb-bar h-full rounded-full ${l.bar}`}
                        data-width={`${Math.round((l.points / maxPoints) * 100)}%`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right arrow (nudges to invite a click) -->
      <button
        id="vs-next"
        aria-label="Next"
        class="vs-nudge shrink-0 bg-white border-2 border-ink shadow-offset-sm rounded-full w-11 h-11 flex items-center justify-center text-ink hover:shadow-none transition-shadow duration-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="flex justify-center gap-2.5 mt-8">
      <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-ink transition-colors" aria-label="Go to slide 1"></button>
      <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-white transition-colors" aria-label="Go to slide 2"></button>
      <button class="vs-dot w-2.5 h-2.5 rounded-full border-2 border-ink bg-white transition-colors" aria-label="Go to slide 3"></button>
    </div>
  </div>
</section>

<style>
  @keyframes vsNudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  .vs-nudge { animation: vsNudge 1.1s ease-in-out infinite; }

  .vs-lb-row {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .vs-lb-row.is-in {
    opacity: 1;
    transform: translateY(0);
  }
  .vs-lb-bar {
    width: 0;
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-nudge { animation: none; }
    .vs-lb-row, .vs-lb-bar { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const track = document.getElementById('vs-track');
    const prev = document.getElementById('vs-prev');
    const next = document.getElementById('vs-next');
    const board = document.getElementById('vs-leaderboard');
    const dots = Array.from(document.querySelectorAll('.vs-dot'));
    if (!track) return;

    const COUNT = 3;
    let index = 0;
    let nudged = false;

    function revealLeaderboard() {
      if (!board) return;
      const rows = Array.from(board.querySelectorAll('.vs-lb-row'));
      // reset, then stagger in so it reads like the sizzle reels
      rows.forEach((row) => {
        row.classList.remove('is-in');
        const bar = row.querySelector('.vs-lb-bar');
        if (bar) bar.style.width = '0';
      });
      rows.forEach((row, i) => {
        setTimeout(() => {
          row.classList.add('is-in');
          const bar = row.querySelector('.vs-lb-bar');
          if (bar) bar.style.width = bar.getAttribute('data-width') || '0';
        }, 120 + i * 280);
      });
    }

    function update() {
      track.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-ink', i === index);
        dot.classList.toggle('bg-white', i !== index);
      });
      if (index === 2) revealLeaderboard();
    }

    function go(to) {
      index = (to + COUNT) % COUNT;
      update();
    }

    function stopNudge() {
      if (nudged) return;
      nudged = true;
      next.classList.remove('vs-nudge');
    }

    prev?.addEventListener('click', () => { stopNudge(); go(index - 1); });
    next?.addEventListener('click', () => { stopNudge(); go(index + 1); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { stopNudge(); go(i); }));

    update();
  })();
</script>
