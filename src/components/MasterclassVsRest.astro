---
const rows = [
  {
    topic: 'Class size',
    bad: '40+ students per call',
    good: '8–15 students per cohort',
  },
  {
    topic: 'Format',
    bad: 'Lecture-based — students stay silent',
    goodHtml: 'Discussion-based — <em>every student</em> participates',
  },
  {
    topic: 'Problems',
    bad: 'Teacher solves everything; students just watch',
    good: 'Students work through problems; Eric walks through the answers',
  },
  {
    topic: 'Curriculum',
    bad: 'Outdated material; Desmos completely ignored',
    good: 'Adjusted for every SAT cycle; Desmos used as much as possible',
  },
  {
    topic: 'Accountability',
    bad: 'Class is too large for instructors to care about each individual student',
    good: 'Regular check-ins to keep every student on pace for their goal score',
  },
];
---

<section class="hidden [@media(min-width:900px)]:block py-16 lg:py-24 bg-peach">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <h2 class="font-sans text-2xl lg:text-4xl font-extrabold text-ink tracking-tight text-center mb-10">
      Not your typical SAT course
    </h2>

    <div class="overflow-x-auto rounded-2xl border-2 border-ink shadow-offset-md">
    <div>

      <!-- Header row -->
      <div class="grid grid-cols-[1fr_2fr_2fr] bg-ink-mid text-white">
        <div class="px-5 py-4 font-sans text-xs font-semibold uppercase tracking-widest text-white/40"></div>
        <div class="px-5 py-4 font-sans text-sm font-semibold uppercase tracking-widest text-white/50 border-l border-white/10">
          Most SAT courses
        </div>
        <div class="px-5 py-4 font-sans text-sm font-semibold uppercase tracking-widest text-electric border-l border-white/10">
          The Masterclass
        </div>
      </div>

      <!-- Data rows -->
      {rows.map((row, i) => (
        <div class={`grid grid-cols-[1fr_2fr_2fr] ${i % 2 === 0 ? 'bg-chalk' : 'bg-white'} border-t border-ink/10`}>

          <!-- Topic -->
          <div class="px-5 py-4 font-sans text-base font-semibold text-ink-mid border-r border-ink/10">
            {row.topic}
          </div>

          <!-- Bad -->
          <div class="px-5 py-4 flex items-start gap-2 border-r border-ink/10">
            <span class="mt-0.5 text-base leading-none select-none text-red-400 shrink-0">✕</span>
            <span class="font-sans text-base text-ink/60">{row.bad}</span>
          </div>

          <!-- Good -->
          <div class="px-5 py-4 flex items-start gap-2 bg-electric/30">
            <span class="mt-0.5 text-base leading-none select-none text-ink-mid font-bold shrink-0">✓</span>
            {row.goodHtml
              ? <span class="font-sans text-base font-bold text-ink-mid" set:html={row.goodHtml} />
              : <span class="font-sans text-base font-bold text-ink-mid">{row.good}</span>
            }
          </div>

        </div>
      ))}

    </div>
    </div>
  </div>
</section>
