---
// Electric "marker" highlight that sweeps in left-to-right on page load.
// Final state (full-width marker) lives in the markup, so no-JS and
// reduced-motion users see the complete highlight.
interface Props {
  class?: string;
  slant?: boolean;
}

const { class: className = 'px-1.5', slant = true } = Astro.props;
---

<span class:list={['relative inline-block text-ink', slant && '-rotate-1', className]}><span class="absolute inset-0 bg-electric" data-marker aria-hidden="true"></span><span class="relative"><slot /></span></span>

<script>
  import { gsap, prefersReducedMotion } from '../scripts/motion';

  if (!prefersReducedMotion()) {
    const markers = gsap.utils.toArray<HTMLElement>('[data-marker]');
    gsap.set(markers, { scaleX: 0, transformOrigin: 'left center' });
    gsap.to(markers, {
      scaleX: 1,
      duration: 0.5,
      ease: 'power2.inOut',
      delay: 0.25,
      stagger: 0.15,
    });
  }
</script>
